/*!
 * \file
 * \brief Samples radioactive birth times inside a source window.
 *
 * These helpers transform a supplied random word; they do not advance an RNG.
 * The host supplies a dimensionless decay constant times the window duration.
 * Integer ticket scaling keeps a nonempty window half-open in absolute
 * picoseconds.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_RADIOACTIVITY_GGEMS_RADIOACTIVE_TIME_SAMPLING_CLH
#define GGEMS_RADIOACTIVITY_GGEMS_RADIOACTIVE_TIME_SAMPLING_CLH

#include "random/GGEMSRandomCommon.clh"

// =============================================================================
// =============================================================================

/*!
 * \brief Approximates the inverse truncated-exponential birth-time CDF.
 *
 * For a window width W and decay rate lambda expressed in reciprocal units of
 * W, let \f$s=\lambda W\f$. The target inverse is
 * \f[
 * r(u,s)=-\frac{\log\left(1-u(1-e^{-s})\right)}{s}.
 * \f]
 * For \f$s\le 2^{-14}\f$, the implementation returns u. For \f$2^{-14}<s\le
 * 0.01\f$, it evaluates the second-order approximation
 * \f[
 * r(u,s)\approx u+\frac{s}{2}u(u-1)+\frac{s^2}{6}u(u-1)(2u-1).
 * \f]
 * Larger s uses expm1 and log1p in binary32. Input finiteness and range are
 * supplied by the caller, not checked by this helper.
 *
 * \param[in] uniform Dimensionless uniform variate u in [0, 1).
 * \param[in] scaled_decay Finite nonnegative s = ln(2) times window width /
 * half-life.
 * \return Dimensionless relative offset r measured from the window start.
 */
static inline float GGEMS_ComputeRadioactiveTimeRelative(float uniform,
                                                         float scaled_decay) {
  if (scaled_decay <= 0x1.0p-14f) {
    return uniform;
  }

  if (scaled_decay <= 0.01f) {
    float const uu = uniform * (uniform - 1.0f);

    return uniform + 0.5f * scaled_decay * uu +
           (1.0f / 6.0f) * scaled_decay * scaled_decay * uu *
             (2.0f * uniform - 1.0f);
  }

  float const decay_mass = -expm1(-scaled_decay);
  return -log1p(-uniform * decay_mass) / scaled_decay;
}

// =============================================================================
// =============================================================================

/*!
 * \brief Quantizes a relative time to a 32-bit fractional-window ticket.
 *
 * For nonnegative inputs this is a floor operation; a relative value of one
 * maps to 2^32 - 1. This ticket quantization is not the general host
 * quantity-rounding policy.
 *
 * \param[in] relative Finite dimensionless relative offset, normally in [0, 1].
 * \return Truncated 2^32 times relative, saturated to the uint range.
 */
static inline uint GGEMS_QuantizeRadioactiveTimeRelative(float relative) {
  return convert_uint_sat_rtz(relative * 4294967296.0f);
}

// =============================================================================
// =============================================================================

/*!
 * \brief Maps a fractional-window ticket to an integer ps offset.
 *
 * Splitting W into high and low 32-bit words evaluates \f$\lfloor
 * Wq/2^{32}\rfloor\f$ without forming a wider full product. No floating-point
 * multiplication of the absolute time is used.
 *
 * \param[in] window_width_ps Nonnegative window width W in integer picoseconds.
 * \param[in] ticket Unsigned 32-bit fractional-window ticket q.
 * \return Floor(W * q / 2^32), in [0, W) for positive W; zero for W = 0.
 */
static inline ulong GGEMS_ScaleRadioactiveTimeTicket(ulong window_width_ps,
                                                     uint ticket) {
  ulong const width_upper = window_width_ps >> 32U;
  ulong const width_lower = window_width_ps & 0xFFFFFFFFUL;
  ulong const ticket_u64 = (ulong)(ticket);

  return width_upper * ticket_u64 + ((width_lower * ticket_u64) >> 32U);
}

// =============================================================================
// =============================================================================

/*!
 * \brief Maps one raw random word to an absolute radioactive birth time.
 *
 * A nonempty window uses the relative inverse, saturating ticket quantization,
 * and exact integer width scaling. The supplied word is converted but no random
 * state is read or advanced.
 *
 * \param[in] time_start_ps Inclusive absolute source-window start in ps.
 * \param[in] time_stop_ps Exclusive absolute source-window stop in ps.
 * \param[in] scaled_decay Finite nonnegative decay rate times the window
 * duration.
 * \param[in] raw_word Raw word whose high 24 bits supply the uniform variate.
 * \return An integer time in [time_start_ps, time_stop_ps), or time_start_ps
 * when stop is not greater than start.
 */
static inline ulong GGEMS_SampleRadioactiveTimeFromRaw(ulong time_start_ps,
                                                       ulong time_stop_ps,
                                                       float scaled_decay,
                                                       uint raw_word) {
  if (time_stop_ps <= time_start_ps) {
    return time_start_ps;
  }

  float const uniform = GGEMS_UIntToUniform01(raw_word);
  float const relative =
    GGEMS_ComputeRadioactiveTimeRelative(uniform, scaled_decay);
  uint const ticket = GGEMS_QuantizeRadioactiveTimeRelative(relative);

  ulong const window_width_ps = time_stop_ps - time_start_ps;
  ulong offset_ps = GGEMS_ScaleRadioactiveTimeTicket(window_width_ps, ticket);

  return time_start_ps + offset_ps;
}

#endif
