/*!
 * \file
 * \brief Defines a placed mesh record for common Navigation.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_MESH_OCCURRENCE_RECORD_CLH
/*! \brief Prevents repeated inclusion of the mesh occurrence layout. */
#define GGEMS_MESH_OCCURRENCE_RECORD_CLH

#include "geometry/GGEMSBoxPoseRecord.clh"

/*! \brief Places one homogeneous physical volume using a shared mesh asset. */
typedef struct GGEMSMeshOccurrenceRecord {
  /*! \brief Rigid transform between this mesh frame and the World frame. */
  GGEMSBoxPoseRecord pose;

  /*! \brief Adaptive surface half-band for this occurrence in FP32 pm. */
  float tolerance_pm;

  /*! \brief Dense material table index for every component of this volume. */
  uint material_id;

  /*! \brief Byte offset of the shared BVH header from the scene buffer base. */
  uint asset_offset;
} GGEMSMeshOccurrenceRecord;

#endif
