/*!
 * \file
 * \brief Defines the common evaluated analytical occurrence layout.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_ANALYTIC_VOLUME_RECORD_CLH

/*!
 * \brief Prevents repeated definition of the shared evaluated occurrence
 * record.
 */
#define GGEMS_ANALYTIC_VOLUME_RECORD_CLH

#include "geometry/GGEMSBoxRecord.clh"
#include "geometry/GGEMSPolyhedraRecord.clh"

/*! \brief World-only scene. */
#define GGEMS_ANALYTIC_NONE 0U

/*! \brief Local Box with a separate FP32 pose. */
#define GGEMS_ANALYTIC_BOX 1U

/*! \brief Full-azimuth finite cylinder with an optional bore. */
#define GGEMS_ANALYTIC_TUBS 2U

/*! \brief Full solid Sphere. */
#define GGEMS_ANALYTIC_SPHERE 3U

/*! \brief Complete solid Ellipsoid with a separate FP32 pose. */
#define GGEMS_ANALYTIC_ELLIPSOID 4U

/*! \brief Rectangular-ended trapezoid with independently tapered X and Y. */
#define GGEMS_ANALYTIC_TRD 5U

/*! \brief General planar trapezoid with inclined and skewed end faces. */
#define GGEMS_ANALYTIC_TRAP 6U

/*! \brief Full-azimuth solid or hollow conical frustum. */
#define GGEMS_ANALYTIC_CONS 7U

/*! \brief Regular polygon with continuous axial profiles. */
#define GGEMS_ANALYTIC_POLYHEDRA 8U

/*! \brief Scalar 16-byte outward plane, with interior dot(normal,p) <= offset.
 */
typedef struct GGEMSPlaneRecord {
  /*! \brief Unit outward normal X component. */
  float normal_x;

  /*! \brief Unit outward normal Y component. */
  float normal_y;

  /*! \brief Unit outward normal Z component. */
  float normal_z;

  /*! \brief Local signed plane offset in pm. */
  float offset_pm;
} GGEMSPlaneRecord;

/*! \brief Scalar 80-byte planar Trd/Trap payload with implicit Z caps. */
typedef struct GGEMSPlanarRecord {
  /*! \brief Four outward side planes in the local frame. */
  GGEMSPlaneRecord sides[4];

  /*! \brief Positive distance to either local Z cap in pm. */
  float half_length_pm;

  /*! \brief Physical owner identity. */
  uint volume_id;

  /*! \brief Dense exact Material identity. */
  uint material_id;

  /*! \brief Closed perpendicular surface half-band in pm. */
  float tolerance_pm;
} GGEMSPlanarRecord;

/*! \brief Scalar 24-byte local cylinder and ownership record. */
typedef struct GGEMSTubsRecord {
  /*! \brief Outer radius in pm. */
  float outer_radius_pm;

  /*! \brief Bore radius in pm; zero means a filled cylinder. */
  float inner_radius_pm;

  /*! \brief Half of the full local Z length in pm. */
  float half_length_pm;

  /*! \brief Physical owner identity. */
  uint volume_id;

  /*! \brief Dense exact Material identity. */
  uint material_id;

  /*! \brief Closed radial and cap surface half-band in pm. */
  float tolerance_pm;
} GGEMSTubsRecord;

/*!
 * \brief Stores the 40-byte local conical-frustum and ownership payload.
 *
 * The host converts negative-Z and positive-Z endpoint radii into midplane
 * radii and dimensionless slopes: r(z) = radius_pm + slope * z. End caps are
 * at +/-half_length_pm, so the full axial length is twice this value. A zero
 * midplane inner radius denotes a solid frustum. Host validation admits apex
 * cases and ensures packed features remain meaningful within the automatic
 * surface bands. Normal scales convert the perpendicular band to a radial
 * offset; the shared rigid pose is stored separately.
 */
typedef struct GGEMSConsRecord {
  /*! \brief Midplane outer radius in pm. */
  float outer_radius_pm;

  /*! \brief Midplane bore radius in pm; zero disables the bore. */
  float inner_radius_pm;

  /*! \brief Outer dr/dz in the local frame. */
  float outer_slope;

  /*! \brief Inner dr/dz in the local frame. */
  float inner_slope;

  /*! \brief Center-to-cap length in pm. */
  float half_length_pm;

  /*! \brief sqrt(1 + outer_slope squared). */
  float outer_normal_scale;

  /*! \brief sqrt(1 + inner_slope squared). */
  float inner_normal_scale;

  /*! \brief Physical owner identity. */
  uint volume_id;

  /*! \brief Dense exact Material identity. */
  uint material_id;

  /*! \brief Closed perpendicular surface half-band in pm. */
  float tolerance_pm;
} GGEMSConsRecord;

/*! \brief Scalar 24-byte local ellipsoid and ownership record. */
typedef struct GGEMSEllipsoidRecord {
  /*! \brief Positive local X semi-axis in pm. */
  float semi_axis_x_pm;

  /*! \brief Positive local Y semi-axis in pm. */
  float semi_axis_y_pm;

  /*! \brief Positive local Z semi-axis in pm. */
  float semi_axis_z_pm;

  /*! \brief Physical owner identity. */
  uint volume_id;

  /*! \brief Dense exact Material identity. */
  uint material_id;

  /*! \brief Closed semi-axis surface half-band in pm. */
  float tolerance_pm;
} GGEMSEllipsoidRecord;

/*! \brief Scalar 28-byte ball and ownership record, matching the host. */
typedef struct GGEMSSphereRecord {
  /*! \brief Global center X in pm. */
  float center_x_pm;

  /*! \brief Global center Y in pm. */
  float center_y_pm;

  /*! \brief Global center Z in pm. */
  float center_z_pm;

  /*! \brief Strictly positive radius in pm. */
  float radius_pm;

  /*! \brief Physical owner identity. */
  uint volume_id;

  /*! \brief Dense exact Material identity. */
  uint material_id;

  /*! \brief Closed radial surface half-band in pm. */
  float tolerance_pm;
} GGEMSSphereRecord;

/*! \brief Payload selected by the enclosing analytic tag. */
typedef union GGEMSAnalyticParameters {
  /*! \brief Compact counts and identities for auxiliary polygon profiles. */
  GGEMSPolyhedraRecord polyhedra;

  /*! \brief Local Box half extents and identities. */
  GGEMSBoxRecord box;

  /*! \brief Sphere center, radius, and identities. */
  GGEMSSphereRecord sphere;

  /*! \brief Cylinder radii, half length, and identities. */
  GGEMSTubsRecord tubs;

  /*! \brief Conical end profiles, cap length, and identities. */
  GGEMSConsRecord cons;

  /*! \brief Ellipsoid semi-axes and identities. */
  GGEMSEllipsoidRecord ellipsoid;

  /*! \brief Trd or Trap side planes, cap length, and identities. */
  GGEMSPlanarRecord planar;
} GGEMSAnalyticParameters;

/*!
 * \brief One 84-byte evaluated occurrence record shared by every transport
 * program.
 */
typedef struct GGEMSAnalyticVolumeRecord {
  /*! \brief GGEMS_ANALYTIC_* predicate selection. */
  uint kind;

  /*! \brief Shape payload; no rotation is allocated for a Sphere. */
  GGEMSAnalyticParameters parameters;
} GGEMSAnalyticVolumeRecord;

#endif
