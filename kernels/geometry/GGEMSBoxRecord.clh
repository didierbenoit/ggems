/*!
 * \file
 * \brief Defines one immutable device analytic Box occurrence.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_BOX_RECORD_CLH
#define GGEMS_BOX_RECORD_CLH

/*! \brief Snapshot-local physical volume identity of the World. */
#define GGEMS_VOLUME_ID_WORLD 0U

/*! \brief Owner identity of a particle that has left the World. */
#define GGEMS_VOLUME_ID_EXTERIOR 0xFFFFFFFFU

/*!
 * \brief Host-mirrored axis-aligned Box occurrence in signed integer pm
 * (56 bytes).
 *
 * Faces lie at the lower and upper coordinates on the integer picometer
 * lattice; each lower coordinate is strictly below its upper coordinate. The
 * host guarantees strict containment within the World.
 */
typedef struct GGEMSBoxRecord {
  /*! \brief Global X coordinate of the -X face. */
  long lower_x_pm;

  /*! \brief Global Y coordinate of the -Y face. */
  long lower_y_pm;

  /*! \brief Global Z coordinate of the -Z face. */
  long lower_z_pm;

  /*! \brief Global X coordinate of the +X face. */
  long upper_x_pm;

  /*! \brief Global Y coordinate of the +Y face. */
  long upper_y_pm;

  /*! \brief Global Z coordinate of the +Z face. */
  long upper_z_pm;

  /*! \brief Snapshot-local physical volume identity; never the World's. */
  uint volume_id;

  /*! \brief Dense snapshot-local Material identity of the Box medium. */
  uint material_id;
} GGEMSBoxRecord;

#endif
