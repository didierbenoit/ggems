/*!
 * \file
 * \brief Defines the immutable device World box.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_WORLD_RECORD_CLH
/*! \brief Prevents repeated inclusion of this OpenCL header. */
#define GGEMS_WORLD_RECORD_CLH

/*! \brief Host-mirrored box parameters in signed FP32 pm (28 bytes). */
typedef struct GGEMSWorldRecord {
  /*! \brief Positive X half extent; zero extents denote no World. */
  float half_extent_x_pm;

  /*! \brief Positive Y half extent; zero extents denote no World. */
  float half_extent_y_pm;

  /*! \brief Positive Z half extent; zero extents denote no World. */
  float half_extent_z_pm;

  /*! \brief Closed surface half-band in pm, validated once on the host. */
  float tolerance_pm;

  /*! \brief Number of physical occurrences, excluding the World. */
  uint occurrence_count;

  /*! \brief Proven straight-ray crossing bound, including World exit. */
  uint max_boundary_events;

  /*!
   * \brief Maximum physical depth: zero when empty, one through three
   * otherwise.
   */
  uint hierarchy_depth;
} GGEMSWorldRecord;

#endif
