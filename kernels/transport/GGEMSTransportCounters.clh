/*!
 * \file
 * \brief Defines shared counters for one diagnostic transport launch.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_TRANSPORT_GGEMS_TRANSPORT_COUNTERS_CLH
/*! \brief Prevents repeated inclusion of this OpenCL header. */
#define GGEMS_TRANSPORT_GGEMS_TRANSPORT_COUNTERS_CLH

/*!
 * \brief Mirrors the host counters used by diagnostic transport kernels.
 *
 * The host resets this record for each chunk and limits claim counts to avoid
 * uint overflow, including terminating claims by workers. Updated stream-kernel
 * counters use global atomics. The claim cursor can exceed the assigned primary
 * count and is not a completion count. Legacy branching/stack fields remain
 * available for other diagnostic kernels; the current stream kernel leaves them
 * unchanged.
 */
typedef struct GGEMSTransportCounters {
  /*! \brief Atomic chunk-local claim cursor, including terminating claims. */
  uint next_primary_id;

  /*!
   * \brief Zero in the stream kernel; host derives admitted primaries from the
   * chunk.
   */
  uint consumed_primary_count;

  /*!
   * \brief Actual successful histories, accumulated privately and published
   * per worker.
   */
  uint completed_history_count;

  /*!
   * \brief Zero in the stream kernel; host derives terminals from actual
   * completions.
   */
  uint terminal_particle_count;

  /*! \brief Created secondary count; untouched by the stream kernel. */
  uint created_secondary_count;

  /*!
   * \brief Synthetic Aionino-to-Gamma count; untouched by the stream kernel.
   */
  uint aionino_to_gamma_count;

  /*!
   * \brief Synthetic Gamma-to-Electron count; untouched by the stream kernel.
   */
  uint gamma_to_electron_count;

  /*!
   * \brief Synthetic Electron branching count; untouched by the stream kernel.
   */
  uint electron_to_electron_count;

  /*!
   * \brief Nonfinite diagnostic endpoints; no terminal publication or
   * completion.
   */
  uint overflow_count;

  /*! \brief Maximum synthetic stack depth; untouched by the stream kernel. */
  uint max_stack_depth;

  /*! \brief Synthetic step count; untouched by the stream kernel. */
  uint total_fake_step_count;

  /*! \brief Navigated births outside the closed World; no completion. */
  uint outside_world_count;

  /*! \brief Navigation queries without a resolvable boundary; no completion. */
  uint unresolved_geometry_count;

  /*! \brief Successful geometric World exits accumulated by stream workers. */
  uint escaped_world_count;
} GGEMSTransportCounters;

#endif
