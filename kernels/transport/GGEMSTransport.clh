/*!
 * \file
 * \brief Generic accepted movement of a particle to a Navigation boundary.
 *
 * Transport owns the accepted geometric transaction: it asks Navigation for
 * the first physical boundary, commits one canonical position, updates the
 * physical owner of the particle and marks the World exit. History
 * lifecycle (counters, capture, completion) stays in the stream kernel.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_TRANSPORT_CLH
#define GGEMS_TRANSPORT_CLH

#include "navigation/GGEMSWorldNavigation.clh"
#include "navigation/GGEMSNavigation.clh"
#include "particles/GGEMSParticleState.clh"
#include "geometry/GGEMSWorldRecord.clh"

#include "geometry/GGEMSAnalyticVolumeRecord.clh"
#include "navigation/GGEMSAnalyticNavigation.clh"

#if GGEMS_ENABLE_FP64_NAVIGATION
#include "navigation/GGEMSAnalyticArithmetic.clh"
#endif

/*!
 * \brief Moves the particle to the exact boundary described by a witness.
 *
 * Movement uses the unrounded parameter gap_pm / |limiting component|. The
 * limiting coordinate lands exactly on its plane; every other coordinate is
 * rounded once, nearest with half away from zero on the final coordinate.
 * A rounded coordinate landing on a plane that was not crossed never adds a
 * plane to the exact witness. Energy, time, direction and RNG are untouched.
 *
 * This helper is deliberately kept out of line (see
 * GGEMS_TransportToNextBoundary).
 *
 * \param[in] gap_pm Forward integer gap to the limiting plane.
 * \param[in] limit_mantissa Significand of the limiting direction component.
 * \param[in] limit_exponent Binary exponent of the limiting component.
 * \param[in,out] particle Private state; unchanged when the move fails.
 * \return Nonzero on success; zero if a displacement is not representable.
 */
static __attribute__((noinline)) uint GGEMS_TransportMoveToBoundary(
  ulong gap_pm, uint limit_mantissa, int limit_exponent,
  GGEMSParticleState *particle) {
  long3 position = (long3)(particle->position_x_pm, particle->position_y_pm,
                           particle->position_z_pm);
  float3 direction = (float3)(particle->direction_x, particle->direction_y,
                              particle->direction_z);
  int half_compare = -1;

  for (uint axis = 0U; axis < 3U; ++axis) {
    GGEMSWorldDirection component = GGEMS_WorldDecodeDirection(direction[axis]);
    ulong displacement = 0UL;

    // The selected minimum guarantees displacement <= the signed-safe gap.
    if (GGEMS_WorldDivide(GGEMS_WorldProduct(gap_pm, component.mantissa),
                          component.exponent - limit_exponent, limit_mantissa,
                          &displacement, &half_compare) == 0U) {
      return 0U;
    }

    long integral = component.negative != 0U
                      ? position[axis] - (long)displacement
                      : position[axis] + (long)displacement;

    uint away = half_compare > 0 ||
                (half_compare == 0 &&
                 (component.negative != 0U ? integral <= 0L : integral >= 0L));

    position[axis] =
      integral + (component.negative != 0U ? -(long)away : (long)away);
  }

  particle->position_x_pm = position.x;
  particle->position_y_pm = position.y;
  particle->position_z_pm = position.z;

  return 1U;
}

#if GGEMS_SPHERE_FP32
/*!
 * \brief Commits the E1 Sphere endpoint using FP32 displacement arithmetic.
 *
 * Retains the integer global anchor and the existing final-coordinate rounding
 * rule. Arithmetic is direct binary32, with no compensation or position repair.
 * All coordinates succeed before commit; energy, time and direction are
 * unchanged.
 * \param[in] parameter Nonnegative FP32 ray parameter in pm.
 * \param[in,out] particle Private particle, unchanged on failure.
 * \return Nonzero on success; zero for an unrepresentable displacement.
 */
static __attribute__((noinline)) uint GGEMS_TransportMoveToSphereFP32Boundary(
  float parameter, GGEMSParticleState *particle) {
  long3 position = (long3)(particle->position_x_pm, particle->position_y_pm,
                           particle->position_z_pm);
  float3 direction = (float3)(particle->direction_x, particle->direction_y,
                               particle->direction_z);
  for (uint axis = 0U; axis < 3U; ++axis) {
    float displacement = parameter * direction[axis];
    if (!isfinite(displacement) || fabs(displacement) >= 0x1p63f) {
      return 0U;
    }
    long integral = convert_long_rtz(displacement);
    float fraction = displacement - (float)integral;
    if ((integral > 0L && position[axis] > LONG_MAX - integral) ||
        (integral < 0L && position[axis] < LONG_MIN - integral)) {
      return 0U;
    }
    long coordinate = position[axis] + integral;
    long adjustment =
      fraction > 0.5f || (fraction == 0.5f && coordinate >= 0L)     ? 1L
      : fraction < -0.5f || (fraction == -0.5f && coordinate <= 0L) ? -1L
                                                                    : 0L;
    if ((coordinate == LONG_MAX && adjustment > 0L) ||
        (coordinate == LONG_MIN && adjustment < 0L)) {
      return 0U;
    }
    position[axis] = coordinate + adjustment;
  }
  particle->position_x_pm = position.x;
  particle->position_y_pm = position.y;
  particle->position_z_pm = position.z;
  return 1U;
}
#endif

#if GGEMS_SPHERE_INTEGER
/*!
 * \brief Commits a rational integer Sphere displacement on the global lattice.
 *
 * Dividing the numerator first avoids multiword division: n/A=q+r/A, so each
 * axis is q*Dint+(r*Dint)/A. In the admitted profiles r*|Dint|<2^59 and the
 * full integral displacement is <2^45 pm. The exact residual rounds the final
 * signed global coordinate nearest with ties away. All coordinates must remain
 * in the closed World before commit; this reports an invalid candidate instead
 * of repairing its position. Persistent direction and other state are
 * unchanged.
 * \param[in] world Exact World bounds, unchanged by the integer approximation.
 * \param[in] boundary Selected integer Sphere rational movement evidence.
 * \param[in,out] particle Private particle, unchanged on failure.
 * \return Nonzero on success; zero for an unrepresentable or outside endpoint.
 */
static __attribute__((noinline)) uint
GGEMS_TransportMoveToSphereIntegerBoundary(
  __global GGEMSWorldRecord const *world,
  GGEMSSphereIntegerBoundary const *boundary, GGEMSParticleState *particle) {
  long3 position = (long3)(particle->position_x_pm, particle->position_y_pm,
                           particle->position_z_pm);
  ulong quotient = boundary->numerator / boundary->denominator;
  ulong remainder = boundary->numerator % boundary->denominator;
  for (uint axis = 0U; axis < 3U; ++axis) {
    uint magnitude = abs(boundary->direction[axis]);
    ulong product = remainder * (ulong)magnitude;
    ulong displacement =
      quotient * (ulong)magnitude + product / boundary->denominator;
    ulong fraction = product % boundary->denominator;
    long integral =
      boundary->direction[axis] < 0 ? -(long)displacement : (long)displacement;
    if ((integral > 0L && position[axis] > LONG_MAX - integral) ||
        (integral < 0L && position[axis] < LONG_MIN - integral)) {
      return 0U;
    }
    long coordinate = position[axis] + integral;
    uint negative = boundary->direction[axis] < 0;
    uint away = fraction * 2UL > boundary->denominator ||
                (fraction * 2UL == boundary->denominator &&
                 (negative != 0U ? coordinate <= 0L : coordinate >= 0L));
    long adjustment = negative != 0U ? -(long)away : (long)away;
    if ((coordinate == LONG_MAX && adjustment > 0L) ||
        (coordinate == LONG_MIN && adjustment < 0L)) {
      return 0U;
    }
    position[axis] = coordinate + adjustment;
  }
  long3 half_extent = (long3)(world->half_extent_x_pm, world->half_extent_y_pm,
                              world->half_extent_z_pm);
  if (any(position < -half_extent) || any(position > half_extent)) {
    return 0U;
  }
  particle->position_x_pm = position.x;
  particle->position_y_pm = position.y;
  particle->position_z_pm = position.z;
  return 1U;
}
#endif

#if GGEMS_ENABLE_FP64_NAVIGATION
/*!
 * \brief Commits a floating analytic endpoint once on the canonical global
 * lattice.
 *
 * The global integer anchor never passes through FP64. A signed integral
 * displacement is added first; the remaining fraction rounds the final signed
 * coordinate half away from zero. All three coordinates succeed before commit.
 * No physical push, energy, time, direction or RNG change is introduced.
 * \param[in] parameter Nonnegative unrounded ray parameter in pm.
 * \param[in,out] particle Private particle, unchanged on failure.
 * \return Nonzero on success; zero for an unrepresentable displacement.
 */
static __attribute__((noinline)) uint GGEMS_TransportMoveToAnalyticBoundary(
  double parameter, GGEMSParticleState *particle) {
  long3 position = (long3)(particle->position_x_pm, particle->position_y_pm,
                           particle->position_z_pm);

  double3 direction = GGEMS_AnalyticDirection((float3)(particle->direction_x,
                                                       particle->direction_y,
                                                       particle->direction_z));

  for (uint axis = 0U; axis < 3U; ++axis) {
    double displacement = parameter * direction[axis];

    if (!isfinite(displacement) || fabs(displacement) >= 0x1p63) {
      return 0U;
    }

    long integral = convert_long_rtz(displacement);
    double fraction = displacement - (double)integral;

    if ((integral > 0L && position[axis] > LONG_MAX - integral) ||
        (integral < 0L && position[axis] < LONG_MIN - integral)) {
      return 0U;
    }

    long coordinate = position[axis] + integral;
    long adjustment =
      fraction > 0.5 || (fraction == 0.5 && coordinate >= 0L)     ? 1L
      : fraction < -0.5 || (fraction == -0.5 && coordinate <= 0L) ? -1L
                                                                  : 0L;

    if ((coordinate == LONG_MAX && adjustment > 0L) ||
        (coordinate == LONG_MIN && adjustment < 0L)) {
      return 0U;
    }

    position[axis] = coordinate + adjustment;
  }

  particle->position_x_pm = position.x;
  particle->position_y_pm = position.y;
  particle->position_z_pm = position.z;
  return 1U;
}
#endif

/*!
 * \brief One accepted geometric transaction: query, move, owner update.
 *
 * From the particle's current physical owner, Navigation supplies the first
 * boundary; the particle is moved to it, its owner identities take the
 * arrival values, and a World exit sets EscapedWorld with the exterior owner
 * (the departure context is available to the caller before this commit). No
 * Process competes here; a future Process proposal is compared with the witness
 * before this commit, strictly earlier Process first and geometry first on
 * exact ties.
 *
 * This transaction and GGEMS_TransportMoveToBoundary are deliberately kept
 * out of line. When the query and the move are inlined into a kernel loop,
 * the Intel CPU OpenCL compiler with -cl-fast-relaxed-math mixes the private
 * states of neighboring work-items (multi-source histories receive each
 * other's positions or end unresolved). The attributes are a documented
 * device-compiler boundary, not a performance choice.
 *
 * \param[in] world Immutable World record.
 * \param[in] volume Immutable tagged volume, or None.
 * \param[in] box_pose Separate Box pose, ignored unless the tag is RotatedBox.
 * \param[in,out] particle Private state with a valid current owner.
 * \param[in,out] event Last accepted event on entry (NONE at birth), updated
 * on success. Retained only while the straight flight direction is unchanged.
 * \param[out] faces Crossing mask, local for rotated Box and zero for Sphere.
 * \return GGEMS_NAVIGATION_RESOLVED after an accepted move; otherwise the
 * failed status and the particle is unchanged.
 */
static __attribute__((noinline)) uint GGEMS_TransportToNextBoundary(
  __global GGEMSWorldRecord const *world,
  __global GGEMSAnalyticVolumeRecord const *volume,
  __global void const *box_pose, GGEMSParticleState *particle, uint *event,
  uint *faces) {
  long3 position = (long3)(particle->position_x_pm, particle->position_y_pm,
                           particle->position_z_pm);
  float3 direction = (float3)(particle->direction_x, particle->direction_y,
                              particle->direction_z);

  GGEMSAnalyticBoundary result;
  uint const status =
    GGEMS_AnalyticFindBoundary(world, volume, box_pose, position, direction,
                               particle->current_volume_id, *event, &result);
  if (status != GGEMS_NAVIGATION_RESOLVED) {
    return status;
  }

  GGEMSBoundaryWitness witness = result.boundary;

  uint moved =
#if GGEMS_SPHERE_INTEGER
    volume->kind == GGEMS_ANALYTIC_SPHERE &&
        witness.event != GGEMS_NAVIGATION_EVENT_WORLD_EXIT
      ? GGEMS_TransportMoveToSphereIntegerBoundary(
          world, &result.sphere_integer, particle)
    :
#endif
#if GGEMS_SPHERE_FP32
    volume->kind == GGEMS_ANALYTIC_SPHERE &&
        witness.event != GGEMS_NAVIGATION_EVENT_WORLD_EXIT
      ? GGEMS_TransportMoveToSphereFP32Boundary(result.sphere_parameter,
                                                particle)
      :
#endif
#if GGEMS_ENABLE_FP64_NAVIGATION
    (volume->kind == GGEMS_ANALYTIC_NONE ||
     volume->kind == GGEMS_ANALYTIC_BOX ||
     witness.event == GGEMS_NAVIGATION_EVENT_WORLD_EXIT)
      ? GGEMS_TransportMoveToBoundary(witness.gap_pm, witness.mantissa,
                                      witness.exponent, particle)
      : GGEMS_TransportMoveToAnalyticBoundary(result.parameter, particle);
#else
    GGEMS_TransportMoveToBoundary(witness.gap_pm, witness.mantissa,
                                  witness.exponent, particle);
#endif
  if (moved == 0U) {
    return GGEMS_NAVIGATION_UNRESOLVED;
  }

  particle->current_volume_id = witness.arrival_volume_id;
  particle->material_id = witness.arrival_material_id;

  if (witness.event == GGEMS_NAVIGATION_EVENT_WORLD_EXIT) {
    particle->status = GGEMS_PARTICLE_STATUS_ESCAPED_WORLD;
  }

  *event = witness.event;
  *faces = witness.faces;

  return GGEMS_NAVIGATION_RESOLVED;
}

#endif
