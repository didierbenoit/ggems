/*!
 * \file
 * \brief Generic accepted movement of a particle to a Navigation boundary.
 *
 * Transport owns the accepted geometric transaction: it asks Navigation for
 * the first physical boundary, commits one FP32 position, updates the
 * physical owner of the particle and marks the World exit. History
 * lifecycle (counters, capture, completion) stays in the stream kernel.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_TRANSPORT_CLH
/*! \brief Prevents repeated inclusion of this OpenCL header. */
#define GGEMS_TRANSPORT_CLH

#include "navigation/GGEMSNavigation.clh"
#include "particles/GGEMSParticleState.clh"
#include "geometry/GGEMSWorldRecord.clh"

#include "geometry/GGEMSAnalyticVolumeRecord.clh"
#include "navigation/GGEMSOccurrenceNavigation.clh"

/*!
 * \brief Commits one finite FP32 endpoint for every transport path.
 *
 * Position and parameter are in pm; direction is dimensionless. All three
 * coordinates succeed before publication. Energy, time, direction and RNG are
 * untouched. This helper remains out of line for the Intel compiler boundary
 * documented in GGEMS_TransportToNextBoundary.
 *
 * \param[in] parameter Nonnegative finite ray parameter in pm.
 * \param[in,out] particle Private state; unchanged on failure.
 * \return Nonzero on success; zero for nonfinite input or endpoint.
 */
static /*! \cond */ __attribute__((noinline)) /*! \endcond */ uint
GGEMS_TransportMoveToBoundary(float parameter, GGEMSParticleState *particle) {
  float3 position = (float3)(particle->position_x_pm, particle->position_y_pm,
                             particle->position_z_pm);

  float3 direction = (float3)(particle->direction_x, particle->direction_y,
                              particle->direction_z);

  // Reject nonfinite raw inputs before forming the physical endpoint.
  if (GGEMS_NavigationIsFinite(parameter) == 0U || parameter < 0.0F ||
      GGEMS_NavigationIsFinite(position.x) == 0U ||
      GGEMS_NavigationIsFinite(position.y) == 0U ||
      GGEMS_NavigationIsFinite(position.z) == 0U ||
      GGEMS_NavigationIsFinite(direction.x) == 0U ||
      GGEMS_NavigationIsFinite(direction.y) == 0U ||
      GGEMS_NavigationIsFinite(direction.z) == 0U ||
      (direction.x == 0.0F && direction.y == 0.0F && direction.z == 0.0F)) {
    return 0U;
  }

  float3 endpoint = position + parameter * direction;
  if (GGEMS_NavigationIsFinite(endpoint.x) == 0U ||
      GGEMS_NavigationIsFinite(endpoint.y) == 0U ||
      GGEMS_NavigationIsFinite(endpoint.z) == 0U) {
    return 0U;
  }

  particle->position_x_pm = endpoint.x;
  particle->position_y_pm = endpoint.y;
  particle->position_z_pm = endpoint.z;
  return 1U;
}

/*!
 * \brief One accepted geometric transaction: query, move, owner update.
 *
 * From the particle's current physical owner, Navigation supplies the first
 * boundary; the particle is moved to it, its owner identities take the
 * arrival values, and a World exit sets EscapedWorld with the exterior owner
 * (the departure context is available to the caller before this commit). No
 * Process competes here; a future Process proposal is compared with the witness
 * before this commit, strictly earlier Process first and geometry first on
 * exact ties.
 *
 * This transaction and GGEMS_TransportMoveToBoundary are deliberately kept
 * out of line. In the former -cl-fast-relaxed-math profile, inlining the
 * query and move into a kernel loop let the Intel CPU OpenCL compiler mix
 * private states of neighboring work-items (multi-source histories receive each
 * other's positions or end unresolved). The attributes are a documented
 * device-compiler boundary. Current production kernels do not enable
 * -cl-fast-relaxed-math.
 *
 * \param[in] world Immutable World record.
 * \param[in] volume Immutable analytical array, or one None record.
 * \param[in] box_pose Immutable single-occurrence auxiliary view, or flat
 * descriptors, poses, and shared profiles for multiple occurrences. Unused
 * only for a World-only scene or one Sphere.
 * \param[in,out] particle Private state with a valid current owner.
 * \param[in,out] event Last accepted event on entry (NONE at birth), updated
 * on success. Retained only while the straight flight direction is unchanged.
 * \param[out] faces Departure World or planar-solid mask; zero for curves.
 * \param[in,out] previous_volume Departure VolumeID of the previous event;
 * updated to this transaction's departure only after successful movement.
 * \return GGEMS_NAVIGATION_RESOLVED after an accepted move; otherwise the
 * failed status and the particle is unchanged.
 */
static /*! \cond */ __attribute__((noinline)) /*! \endcond */ uint
GGEMS_TransportToNextBoundary(__global GGEMSWorldRecord const *world,
                              __global GGEMSAnalyticVolumeRecord const *volume,
                              __global void const *box_pose,
                              GGEMSParticleState *particle, uint *event,
                              uint *faces, uint *previous_volume) {
  float3 position = (float3)(particle->position_x_pm, particle->position_y_pm,
                             particle->position_z_pm);

  float3 direction = (float3)(particle->direction_x, particle->direction_y,
                              particle->direction_z);

  GGEMSBoundaryWitness witness;
  uint const status = GGEMS_SceneFindBoundary(
    world, volume, box_pose, position, direction, particle->current_volume_id,
    *event, *previous_volume, &witness);

  if (status != GGEMS_NAVIGATION_RESOLVED) {
    return status;
  }

  uint moved = GGEMS_TransportMoveToBoundary(witness.parameter, particle);

  if (moved == 0U) {
    return GGEMS_NAVIGATION_UNRESOLVED;
  }

  *previous_volume = particle->current_volume_id;
  particle->current_volume_id = witness.arrival_volume_id;
  particle->material_id = witness.arrival_material_id;

  if (witness.event == GGEMS_NAVIGATION_EVENT_WORLD_EXIT) {
    particle->status = GGEMS_PARTICLE_STATUS_ESCAPED_WORLD;
  }

  *event = witness.event;
  *faces = witness.faces;

  return GGEMS_NAVIGATION_RESOLVED;
}

#endif
