/*!
 * \file
 * \brief Finds World exits with FP32 slab parameters in pm.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_WORLD_NAVIGATION_CLH
/*! \brief Prevents repeated inclusion of World navigation. */
#define GGEMS_WORLD_NAVIGATION_CLH

#include "geometry/GGEMSBoxRecord.clh"
#include "geometry/GGEMSWorldRecord.clh"

#include "navigation/GGEMSNavigation.clh"

/*!
 * \brief Validates the represented ray without computing a boundary parameter.
 *
 * Birth location and boundary queries share this validation. A nonzero stored
 * direction is required without a norm threshold. Raw exponent checks retain
 * nonfinite rejection under fast-math compiler assumptions.
 * \param[in] world Host-validated FP32 half extents, or zero if absent.
 * \param[in] position Global FP32 position in pm.
 * \param[in] direction Actual stored direction.
 * \return Resolved, outside World, or unresolved.
 */
static inline uint
GGEMS_WorldValidateRay(__global GGEMSWorldRecord const *world, float3 position,
                       float3 direction) {
  if (world->half_extent_x_pm == 0.0F) {
    return GGEMS_NAVIGATION_UNRESOLVED;
  }

  float3 half_extent =
    (float3)(world->half_extent_x_pm, world->half_extent_y_pm,
             world->half_extent_z_pm);

  for (uint axis = 0U; axis < 3U; ++axis) {
    if (GGEMS_NavigationIsFinite(position[axis]) == 0U ||
        GGEMS_NavigationIsFinite(direction[axis]) == 0U) {
      return GGEMS_NAVIGATION_UNRESOLVED;
    }

    if (position[axis] < -half_extent[axis] ||
        position[axis] > half_extent[axis]) {
      return GGEMS_NAVIGATION_OUTSIDE_WORLD;
    }
  }

  return direction.x != 0.0F || direction.y != 0.0F || direction.z != 0.0F
           ? GGEMS_NAVIGATION_RESOLVED
           : GGEMS_NAVIGATION_UNRESOLVED;
}

/*!
 * \brief Finds the first FP32 exit from the closed origin-centered World.
 *
 * Zero components are parallel. An outward boundary start exits at zero and
 * equal FP32 parameters combine crossing faces. No endpoint snapping or
 * displacement is applied. Private pointer output preserves the established
 * Intel NEO 26.35 workaround for nested structure-returning navigation calls.
 * \param[in] world Host-validated FP32 half extents, or zero if absent.
 * \param[in] position Global FP32 position in pm.
 * \param[in] direction Actual stored direction.
 * \param[out] witness Selected World exit and exterior arrival owner.
 * \return Resolved, outside World, or unresolved.
 */
static inline uint
GGEMS_WorldFindBoundary(__global GGEMSWorldRecord const *world, float3 position,
                        float3 direction, GGEMSBoundaryWitness *witness) {
  witness->parameter = FLT_MAX;
  witness->faces = 0U;
  witness->event = GGEMS_NAVIGATION_EVENT_NONE;
  witness->arrival_volume_id = GGEMS_VOLUME_ID_EXTERIOR;
  witness->arrival_material_id = GGEMS_MATERIAL_ID_NONE;
  witness->status = GGEMS_WorldValidateRay(world, position, direction);

  if (witness->status != GGEMS_NAVIGATION_RESOLVED) {
    return witness->status;
  }

  witness->status = GGEMS_NAVIGATION_UNRESOLVED;

  float3 half_extent =
    (float3)(world->half_extent_x_pm, world->half_extent_y_pm,
             world->half_extent_z_pm);
  for (uint axis = 0U; axis < 3U; ++axis) {
    float component = direction[axis];
    if (component == 0.0F) {
      continue;
    }

    uint positive = component > 0.0F;
    float plane = positive != 0U ? half_extent[axis] : -half_extent[axis];
    float parameter = (plane - position[axis]) / component;
    uint face = 1U << (2U * axis + positive);

    if (parameter < witness->parameter) {
      witness->parameter = parameter;
      witness->faces = face;
    } else if (parameter == witness->parameter) {
      witness->faces |= face;
    }
  }

  if (witness->faces != 0U &&
      GGEMS_NavigationIsFinite(witness->parameter) != 0U &&
      witness->parameter >= 0.0F) {
    witness->event = GGEMS_NAVIGATION_EVENT_WORLD_EXIT;
    witness->status = GGEMS_NAVIGATION_RESOLVED;
  }

  return witness->status;
}

#endif
