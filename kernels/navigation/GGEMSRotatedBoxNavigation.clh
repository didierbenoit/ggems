/*!
 * \file
 * \brief FP64 local-plane queries for one rigidly placed Box.
 *
 * R has the same right-handed local-to-World column convention as Source.
 * FP64 navigation programs include this file; exact-only scenes retain the
 * exact integer helpers without requiring FP64. Query outputs remain private
 * pointer outputs across the qualified out-of-line Transport boundary.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */
#ifndef GGEMS_ROTATED_BOX_NAVIGATION_CLH
#define GGEMS_ROTATED_BOX_NAVIGATION_CLH

#include "geometry/GGEMSBoxPoseRecord.clh"
#include "navigation/GGEMSAnalyticArithmetic.clh"
#include "geometry/GGEMSBoxRecord.clh"
#include "geometry/GGEMSWorldRecord.clh"
#include "navigation/GGEMSWorldNavigation.clh"
#include "navigation/GGEMSNavigation.clh"

/*!
 * \brief Transforms a canonical anchor and stored direction with R transpose.
 *
 * Integer subtraction precedes conversion: a large shared origin never enters
 * the floating subtraction. Admitted World coordinates bound the difference
 * inside int64. The local resolution band is 16 binary64 epsilons times the
 * relative coordinate/extent scale, not a physical displacement or tolerance
 * added to the Box. The separate half-pm projection bounds canonical rounding.
 * \param[in] box Local faces of the single Box.
 * \param[in] pose Immutable local-to-World basis and canonical center.
 * \param[in] position Canonical start inside the closed World.
 * \param[in] direction Actual stored direction.
 * \param[out] local_position Local position in pm.
 * \param[out] local_direction Local direction without renormalization.
 * \param[out] resolution Local arithmetic resolution in pm.
 * \param[out] rounding Bound per local axis for a rounded global endpoint.
 */
static inline void GGEMS_RotatedBoxRay(__global GGEMSBoxRecord const *box,
                                       __global GGEMSBoxPoseRecord const *pose,
                                       long3 position, float3 direction,
                                       double3 *local_position,
                                       double3 *local_direction,
                                       double *resolution, double3 *rounding) {
  long3 relative =
    position - (long3)(pose->center_x_pm, pose->center_y_pm, pose->center_z_pm);
  double3 offset = convert_double3(relative);
  double3 motion = GGEMS_AnalyticDirection(direction);
  double3 columns[3] = {
    (double3)(pose->axis_x_x, pose->axis_x_y, pose->axis_x_z),
    (double3)(pose->axis_y_x, pose->axis_y_y, pose->axis_y_z),
    (double3)(pose->axis_z_x, pose->axis_z_y, pose->axis_z_z)};
  double extent = fmax((double)box->upper_x_pm,
                       fmax((double)box->upper_y_pm, (double)box->upper_z_pm));
  *resolution =
    0x1p-48 * (fabs(offset.x) + fabs(offset.y) + fabs(offset.z) + extent);
  for (uint axis = 0U; axis < 3U; ++axis) {
    double3 column = columns[axis];
    (*local_position)[axis] = dot(column, offset);
    (*local_direction)[axis] = dot(column, motion);
    (*rounding)[axis] =
      0.5 * (fabs(column.x) + fabs(column.y) + fabs(column.z)) + *resolution;
  }
}

/*!
 * \brief Locates the owner on the forward open ray at birth.
 *
 * Within local arithmetic resolution, a plane uses the forward direction.
 * Motion along a face/edge does not enter. This locating-only decision neither
 * moves the canonical position nor adds path length. World validation precedes
 * the signed center subtraction.
 * \param[in] world Finite origin-centered World.
 * \param[in] box Local Box faces and owner identities.
 * \param[in] pose Immutable Box placement.
 * \param[in] position Canonical birth position.
 * \param[in] direction Stored birth direction.
 * \param[out] owner Packed VolumeID/MaterialID on success.
 * \return Navigation status; no owner is produced for an invalid ray.
 */
static inline uint
GGEMS_RotatedBoxLocate(__global GGEMSWorldRecord const *world,
                       __global GGEMSBoxRecord const *box,
                       __global GGEMSBoxPoseRecord const *pose, long3 position,
                       float3 direction, ulong *owner) {
  GGEMSWorldBoundary world_exit =
    GGEMS_WorldFindBoundary(world, position, direction);

  if (world_exit.status != GGEMS_WORLD_EXIT) {
    return world_exit.status;
  }

  double3 local_position;
  double3 local_direction;
  double3 rounding;
  double resolution;

  GGEMS_RotatedBoxRay(box, pose, position, direction, &local_position,
                      &local_direction, &resolution, &rounding);

  double3 motion = GGEMS_AnalyticDirection(direction);
  double direction_resolution =
    0x1p-48 * (fabs(motion.x) + fabs(motion.y) + fabs(motion.z));
  double3 extent =
    convert_double3((long3)(box->upper_x_pm, box->upper_y_pm, box->upper_z_pm));
  *owner = ((ulong)GGEMS_VOLUME_ID_WORLD << 32U) | GGEMS_MATERIAL_ID_WORLD;

  for (uint axis = 0U; axis < 3U; ++axis) {
    double coordinate = local_position[axis];
    double component = local_direction[axis];
    // A nearly parallel direction at a numerically unresolved plane has no
    // reliable side. Fail explicitly instead of fabricating a crossing.
    if (component != 0.0 && fabs(component) <= direction_resolution &&
        fabs(fabs(coordinate) - extent[axis]) <= resolution) {
      return GGEMS_NAVIGATION_UNRESOLVED;
    }

    if (fabs(coordinate) > extent[axis] + resolution ||
        (coordinate <= -extent[axis] + resolution && component <= 0.0) ||
        (coordinate >= extent[axis] - resolution && component >= 0.0)) {
      return GGEMS_NAVIGATION_RESOLVED;
    }
  }

  *owner = ((ulong)box->volume_id << 32U) | box->material_id;
  return GGEMS_NAVIGATION_RESOLVED;
}

/*!
 * \brief Selects a rotated Box crossing before endpoint rounding.
 *
 * The one-Box, straight, Process-free flight cannot reenter after an exit.
 * last_event retains that fact across a rounded endpoint. On entry the known
 * Box owner selects outgoing planes, even if rounding puts the anchor just
 * beyond an entry face. An outgoing plane missed by at most the projection of
 * half a global pm is resolved at zero additional parameter. A larger negative
 * gap fails explicitly. A positive chord shorter than the local arithmetic
 * resolution, or a nearly parallel surface ray, is unresolved. Neither rule
 * pushes a particle or charges a flight. This last-event rule must be reset if
 * a future Process changes direction.
 *
 * \param[in] world Exact World exit authority.
 * \param[in] box Single Box, expressed in its centered local frame.
 * \param[in] pose Immutable rigid placement.
 * \param[in] position Canonical global anchor.
 * \param[in] direction Actual stored direction.
 * \param[in] current_owner Known physical departure owner.
 * \param[in] last_event Previously accepted event, or NONE at birth.
 * \param[out] witness Event, local face mask and arrival owner; exact World
 * fields remain valid when World exit wins.
 * \param[out] parameter Forward parameter in pm, without unit-norm assumption.
 * \return Resolved, outside World, or bounded unresolved status.
 */
static inline uint GGEMS_RotatedBoxFindBoundary(
  __global GGEMSWorldRecord const *world, __global GGEMSBoxRecord const *box,
  __global GGEMSBoxPoseRecord const *pose, long3 position, float3 direction,
  uint current_owner, uint last_event, GGEMSBoundaryWitness *witness,
  double *parameter) {
  uint status = GGEMS_NavigationFindBoundary(
    world, box, 0U, position, direction, GGEMS_VOLUME_ID_WORLD, witness);

  if (status != GGEMS_NAVIGATION_RESOLVED) {
    return status;
  }

  *parameter = ldexp((double)witness->gap_pm / (double)witness->mantissa,
                     -witness->exponent);

  if (last_event == GGEMS_NAVIGATION_EVENT_VOLUME_EXIT &&
      current_owner == GGEMS_VOLUME_ID_WORLD) {
    return GGEMS_NAVIGATION_RESOLVED;
  }

  double3 local_position;
  double3 local_direction;
  double3 rounding;
  double resolution;

  GGEMS_RotatedBoxRay(box, pose, position, direction, &local_position,
                      &local_direction, &resolution, &rounding);

  double3 motion = GGEMS_AnalyticDirection(direction);
  double direction_resolution =
    0x1p-48 * (fabs(motion.x) + fabs(motion.y) + fabs(motion.z));
  double3 extent =
    convert_double3((long3)(box->upper_x_pm, box->upper_y_pm, box->upper_z_pm));
  uint inside = current_owner == box->volume_id;
  double near_parameter = -INFINITY;
  double far_parameter = INFINITY;
  uint near_faces = 0U;
  uint far_faces = 0U;
  double near_resolution = 0.0;
  double far_resolution = 0.0;

  for (uint axis = 0U; axis < 3U; ++axis) {
    double coordinate = local_position[axis];
    double component = local_direction[axis];
    // A nearly parallel direction at a numerically unresolved plane has no
    // reliable side. Fail explicitly instead of fabricating a crossing.
    if (component != 0.0 && fabs(component) <= direction_resolution &&
        fabs(fabs(coordinate) - extent[axis]) <= resolution) {
      return GGEMS_NAVIGATION_UNRESOLVED;
    }

    if (component == 0.0) {
      if (inside == 0U && fabs(coordinate) >= extent[axis] - resolution) {
        return GGEMS_NAVIGATION_RESOLVED;
      }
      continue;
    }

    uint negative = component < 0.0;
    double far_gap = extent[axis] - (negative != 0U ? -coordinate : coordinate);

    if (inside != 0U && far_gap < 0.0) {
      if (far_gap < -rounding[axis]) {
        return GGEMS_NAVIGATION_UNRESOLVED;
      }
      far_gap = 0.0;
    }

    double far_value = far_gap / fabs(component);
    double near_value =
      (-extent[axis] - (negative != 0U ? -coordinate : coordinate)) /
      fabs(component);
    uint near_face = 1U << (2U * axis + negative);
    uint far_face = 1U << (2U * axis + (negative == 0U));

    if (near_value > near_parameter) {
      near_parameter = near_value;
      near_faces = near_face;
      near_resolution = resolution / fabs(component);
    } else if (near_value == near_parameter) {
      near_faces |= near_face;
    }

    if (far_value < far_parameter) {
      far_parameter = far_value;
      far_faces = far_face;
      far_resolution = resolution / fabs(component);
    } else if (far_value == far_parameter) {
      far_faces |= far_face;
    }
  }

  if (inside == 0U &&
      (near_parameter >= far_parameter || far_parameter <= 0.0)) {
    return GGEMS_NAVIGATION_RESOLVED;
  }

  if (inside == 0U &&
      far_parameter - near_parameter <= near_resolution + far_resolution) {
    return GGEMS_NAVIGATION_UNRESOLVED;
  }

  double candidate = inside != 0U ? far_parameter : near_parameter;

  if (!isfinite(candidate) || candidate < 0.0 || candidate == *parameter) {
    return GGEMS_NAVIGATION_UNRESOLVED;
  }

  if (candidate > *parameter) {
    return inside != 0U ? GGEMS_NAVIGATION_UNRESOLVED
                        : GGEMS_NAVIGATION_RESOLVED;
  }

  *parameter = candidate;
  witness->faces = inside != 0U ? far_faces : near_faces;
  witness->event = inside != 0U ? GGEMS_NAVIGATION_EVENT_VOLUME_EXIT
                                : GGEMS_NAVIGATION_EVENT_VOLUME_ENTRY;
  witness->arrival_volume_id =
    inside != 0U ? GGEMS_VOLUME_ID_WORLD : box->volume_id;
  witness->arrival_material_id =
    inside != 0U ? GGEMS_MATERIAL_ID_WORLD : box->material_id;
  return GGEMS_NAVIGATION_RESOLVED;
}

#endif
