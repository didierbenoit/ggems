/*!
 * \file
 * \brief Shares FP64 direction decoding between analytic predicates and
 * Transport.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_ANALYTIC_ARITHMETIC_CLH
#define GGEMS_ANALYTIC_ARITHMETIC_CLH

#include "navigation/GGEMSWorldNavigation.clh"

/*!
 * \brief Promotes the actual stored direction, including binary32 subnormals.
 * \param[in] direction Stored direction, already validated by World.
 * \return Exact binary64 representation of the stored components.
 */
static inline double3 GGEMS_AnalyticDirection(float3 direction) {
  double3 result;
  for (uint axis = 0U; axis < 3U; ++axis) {
    GGEMSWorldDirection part = GGEMS_WorldDecodeDirection(direction[axis]);
    result[axis] = ldexp((double)part.mantissa, part.exponent);
    if (part.negative != 0U) {
      result[axis] = -result[axis];
    }
  }
  return result;
}

#endif
