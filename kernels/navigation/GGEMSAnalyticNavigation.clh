/*!
 * \file
 * \brief Dispatches one analytical occurrence through FP32 local predicates.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_ANALYTIC_NAVIGATION_CLH
/*! \brief Prevents repeated inclusion of analytic dispatch. */
#define GGEMS_ANALYTIC_NAVIGATION_CLH

#include "geometry/GGEMSAnalyticVolumeRecord.clh"
#include "geometry/GGEMSBoxRecord.clh"
#include "geometry/GGEMSBoxPoseRecord.clh"
#include "geometry/GGEMSWorldRecord.clh"
#include "navigation/GGEMSWorldNavigation.clh"
#include "navigation/GGEMSNavigation.clh"
#include "navigation/GGEMSBoxNavigation.clh"
#include "navigation/GGEMSSphereNavigation.clh"
#include "navigation/GGEMSTubsNavigation.clh"
#include "navigation/GGEMSConsNavigation.clh"
#include "navigation/GGEMSPolyhedraNavigation.clh"
#include "navigation/GGEMSEllipsoidNavigation.clh"
#include "navigation/GGEMSPlanarNavigation.clh"

/*!
 * \brief Locates the forward owner through the selected analytic predicate.
 * \param[in] volume Single volume or None.
 * \param[in] box_pose Immutable auxiliary buffer: a shared rigid pose for
 * nonspherical solids, followed by side and section arrays for Polyhedra.
 * Unused for Sphere and a World-only scene.
 * \param[in] position Global FP32 position in pm.
 * \param[in] direction Actual stored direction.
 * \param[out] owner Packed VolumeID/MaterialID on success.
 * \return Resolved or unresolved; the caller has validated the World ray.
 */
static inline uint
GGEMS_AnalyticLocateVolume(__global GGEMSAnalyticVolumeRecord const *volume,
                           __global void const *box_pose, float3 position,
                           float3 direction, ulong *owner) {
  if (volume->kind == GGEMS_ANALYTIC_BOX) {
    return GGEMS_BoxLocate(&volume->parameters.box,
                           (__global GGEMSBoxPoseRecord const *)box_pose,
                           position, direction, owner);
  }

  if (volume->kind == GGEMS_ANALYTIC_SPHERE) {
    return GGEMS_SphereLocate(&volume->parameters.sphere, position, direction,
                              owner);
  }

  if (volume->kind == GGEMS_ANALYTIC_TUBS) {
    return GGEMS_TubsLocate(&volume->parameters.tubs,
                            (__global GGEMSBoxPoseRecord const *)box_pose,
                            position, direction, owner);
  }

  if (volume->kind == GGEMS_ANALYTIC_ELLIPSOID) {
    return GGEMS_EllipsoidLocate(&volume->parameters.ellipsoid,
                                 (__global GGEMSBoxPoseRecord const *)box_pose,
                                 position, direction, owner);
  }

  if (volume->kind == GGEMS_ANALYTIC_TRD ||
      volume->kind == GGEMS_ANALYTIC_TRAP) {
    return GGEMS_PlanarLocate(&volume->parameters.planar,
                              (__global GGEMSBoxPoseRecord const *)box_pose,
                              position, direction, owner);
  }

  if (volume->kind == GGEMS_ANALYTIC_POLYHEDRA) {
    return GGEMS_PolyhedraLocate(&volume->parameters.polyhedra, box_pose,
                                 position, direction, owner);
  }

  if (volume->kind == GGEMS_ANALYTIC_CONS) {
    return GGEMS_ConsLocate(&volume->parameters.cons,
                            (__global GGEMSBoxPoseRecord const *)box_pose,
                            position, direction, owner);
  }

  *owner = ((ulong)GGEMS_VOLUME_ID_WORLD << 32U) | GGEMS_MATERIAL_ID_WORLD;

  return GGEMS_NAVIGATION_RESOLVED;
}

/*!
 * \brief Locates one occurrence after validating the global ray against World.
 * \param[in] world Immutable FP32 World bounds and surface band.
 * \param[in] volume One analytical record or None.
 * \param[in] box_pose Immutable occurrence pose and optional profile data.
 * \param[in] position Global FP32 position in pm.
 * \param[in] direction Actual stored direction.
 * \param[out] owner Packed forward VolumeID/MaterialID on success.
 * \return Resolved, outside World, or unresolved.
 */
static inline uint
GGEMS_AnalyticLocate(__global GGEMSWorldRecord const *world,
                     __global GGEMSAnalyticVolumeRecord const *volume,
                     __global void const *box_pose, float3 position,
                     float3 direction, ulong *owner) {
  uint const status = GGEMS_WorldValidateRay(world, position, direction);

  return status == GGEMS_NAVIGATION_RESOLVED
           ? GGEMS_AnalyticLocateVolume(volume, box_pose, position, direction,
                                        owner)
           : status;
}

/*!
 * \brief Selects the next analytic crossing or FP32 World exit.
 *
 * One convex volume and an unchanged straight-flight direction cannot reenter
 * after an accepted exit. Tubs and Cons can reenter beyond a bore, while
 * Polyhedra can contain multiple material intervals through its bore or concave
 * axial profile. Their interval predicates retain later entries. Ownership
 * selects the next root without relocating the FP32 endpoint.
 * \param[in] volume Single volume or None.
 * \param[in] box_pose Immutable auxiliary buffer: a shared rigid pose for
 * nonspherical solids, followed by side and section arrays for Polyhedra.
 * Unused for Sphere and a World-only scene.
 * \param[in] position Global FP32 anchor in pm.
 * \param[in] direction Actual stored direction.
 * \param[in] current_owner Known physical departure VolumeID.
 * \param[in] last_event Previously accepted event while direction is unchanged.
 * \param[in,out] result Independent upper-bound witness on input, selected
 * occurrence crossing on output. Interior exits and hierarchy queries use
 * INFINITY so coincident surfaces do not fail the leaf's strict bound check.
 * \return Resolved, outside World, or unresolved.
 */
static inline uint GGEMS_AnalyticVolumeFindBoundary(
  __global GGEMSAnalyticVolumeRecord const *volume,
  __global void const *box_pose, float3 position, float3 direction,
  uint current_owner, uint last_event, GGEMSBoundaryWitness *result) {
  if (volume->kind == GGEMS_ANALYTIC_NONE ||
      (current_owner == GGEMS_VOLUME_ID_WORLD &&
       last_event == GGEMS_NAVIGATION_EVENT_VOLUME_EXIT &&
       volume->kind != GGEMS_ANALYTIC_TUBS &&
       volume->kind <= GGEMS_ANALYTIC_TRAP)) {
    return GGEMS_NAVIGATION_RESOLVED;
  }

  if (volume->kind == GGEMS_ANALYTIC_BOX) {
    return GGEMS_BoxFindBoundary(&volume->parameters.box,
                                 (__global GGEMSBoxPoseRecord const *)box_pose,
                                 position, direction, current_owner, result);
  }

  if (volume->kind == GGEMS_ANALYTIC_TUBS) {
    return GGEMS_TubsFindBoundary(
      &volume->parameters.tubs, (__global GGEMSBoxPoseRecord const *)box_pose,
      position, direction, current_owner, last_event, result);
  }

  if (volume->kind == GGEMS_ANALYTIC_ELLIPSOID) {
    return GGEMS_EllipsoidFindBoundary(
      &volume->parameters.ellipsoid,
      (__global GGEMSBoxPoseRecord const *)box_pose, position, direction,
      current_owner, result);
  }

  if (volume->kind == GGEMS_ANALYTIC_TRD ||
      volume->kind == GGEMS_ANALYTIC_TRAP) {
    return GGEMS_PlanarFindBoundary(
      &volume->parameters.planar, (__global GGEMSBoxPoseRecord const *)box_pose,
      position, direction, current_owner, result);
  }

  if (volume->kind == GGEMS_ANALYTIC_SPHERE) {
    return GGEMS_SphereFindBoundary(&volume->parameters.sphere, position,
                                    direction, current_owner, result);
  }

  if (volume->kind == GGEMS_ANALYTIC_POLYHEDRA) {
    return GGEMS_PolyhedraFindBoundary(&volume->parameters.polyhedra, box_pose,
                                       position, direction, current_owner,
                                       last_event, result);
  }

  if (volume->kind == GGEMS_ANALYTIC_CONS) {
    return GGEMS_ConsFindBoundary(
      &volume->parameters.cons, (__global GGEMSBoxPoseRecord const *)box_pose,
      position, direction, current_owner, last_event, result);
  }

  return GGEMS_NAVIGATION_RESOLVED;
}

/*!
 * \brief Selects one occurrence crossing against the finite World exit.
 *
 * An outward World-band exit retains the World witness and its face mask.
 * \param[in] world Immutable FP32 World boundary authority.
 * \param[in] volume One analytical record or None.
 * \param[in] box_pose Immutable occurrence pose and optional profile data.
 * \param[in] position Global FP32 anchor in pm.
 * \param[in] direction Actual stored direction.
 * \param[in] current_owner Accepted departure VolumeID.
 * \param[in] last_event Previous event for this occurrence and direction.
 * \param[out] result Selected physical crossing and arrival identities.
 * \return Resolved, outside World, or unresolved.
 */
static inline uint
GGEMS_AnalyticFindBoundary(__global GGEMSWorldRecord const *world,
                           __global GGEMSAnalyticVolumeRecord const *volume,
                           __global void const *box_pose, float3 position,
                           float3 direction, uint current_owner,
                           uint last_event, GGEMSBoundaryWitness *result) {
  uint const status =
    GGEMS_WorldFindBoundary(world, position, direction, result);

  if (status != GGEMS_NAVIGATION_RESOLVED) {
    return status;
  }

  if (current_owner == GGEMS_VOLUME_ID_WORLD) {
    return GGEMS_AnalyticVolumeFindBoundary(
      volume, box_pose, position, direction, current_owner, last_event, result);
  }

  GGEMSBoundaryWitness candidate = *result;
  candidate.parameter = INFINITY;
  uint const candidate_status =
    GGEMS_AnalyticVolumeFindBoundary(volume, box_pose, position, direction,
                                     current_owner, last_event, &candidate);

  if (candidate_status == GGEMS_NAVIGATION_RESOLVED &&
      candidate.parameter < result->parameter &&
      GGEMS_WorldForwardExitFaces(
        world, position + candidate.parameter * direction, direction) == 0U) {
    *result = candidate;
  }

  return candidate_status;
}

#endif
