/*!
 * \file
 * \brief Resolves full solid Sphere ownership and crossings in local FP32.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_SPHERE_NAVIGATION_CLH
/*! \brief Prevents repeated inclusion of the Sphere predicates. */
#define GGEMS_SPHERE_NAVIGATION_CLH

#include "geometry/GGEMSAnalyticVolumeRecord.clh"
#include "geometry/GGEMSBoxRecord.clh"
#include "navigation/GGEMSNavigation.clh"

/*!
 * \brief Locates the forward owner of a canonical birth in the closed World.
 *
 * Integer center subtraction precedes FP32 conversion. Direct squared-radius
 * classification uses inward radial motion at a represented surface; an
 * outward or tangent surface birth belongs to the World. No tolerance or
 * displacement is introduced.
 * \param[in] sphere Complete ball and owner identities.
 * \param[in] position Canonical point already validated against the World.
 * \param[in] direction Actual finite, nonzero stored direction.
 * \param[out] owner Packed forward VolumeID/MaterialID.
 * \return Resolved according to the FP32 radial classification.
 */
static inline uint GGEMS_SphereLocate(__global GGEMSSphereRecord const *sphere,
                                      long3 position, float3 direction,
                                      ulong *owner) {
  long3 relative = position - (long3)(sphere->center_x_pm, sphere->center_y_pm,
                                      sphere->center_z_pm);

  float3 offset = convert_float3(relative);
  float radius = (float)sphere->radius_pm;
  float radial = dot(offset, offset) - radius * radius;
  float motion = dot(offset, direction);
  uint inside = radial < 0.0F || (radial == 0.0F && motion < 0.0F);

  *owner = inside != 0U
             ? ((ulong)sphere->volume_id << 32U) | sphere->material_id
             : ((ulong)GGEMS_VOLUME_ID_WORLD << 32U) | GGEMS_MATERIAL_ID_WORLD;
  return GGEMS_NAVIGATION_RESOLVED;
}

/*!
 * \brief Selects a direct FP32 Sphere crossing against the resolved World exit.
 *
 * For q = P-C and stored D, a = D.D, b = q.D, c = q.q-R^2. The selected root
 * is (-b-sqrt(b*b-a*c))/a for entry and (-b+sqrt(b*b-a*c))/a for exit.
 * A nonpositive discriminant has no crossing for an outside owner. Accepted
 * arrival ownership selects the exit root without relocating the rounded
 * anchor. Analytic dispatch suppresses reentry after an accepted convex exit
 * while direction stays unchanged. Arithmetic failures remain unresolved; no
 * compensation, near-surface envelope, or endpoint repair is applied.
 * \param[in] sphere Immutable full ball.
 * \param[in] position Canonical start in the closed World.
 * \param[in] direction Actual stored finite direction.
 * \param[in] current_owner Accepted departure owner.
 * \param[in,out] witness World exit on entry; chosen crossing on success.
 * \param[in,out] parameter World parameter on entry; selected parameter on
 * success.
 * \return Resolved or unresolved for invalid arithmetic or boundary ordering.
 */
static inline uint
GGEMS_SphereFindBoundary(__global GGEMSSphereRecord const *sphere,
                         long3 position, float3 direction, uint current_owner,
                         GGEMSBoundaryWitness *witness, float *parameter) {
  long3 relative = position - (long3)(sphere->center_x_pm, sphere->center_y_pm,
                                      sphere->center_z_pm);

  float3 offset = convert_float3(relative);
  float radius = (float)sphere->radius_pm;
  float a = dot(direction, direction);
  float b = dot(offset, direction);

  uint inside = current_owner == sphere->volume_id;

  if (inside == 0U && b >= 0.0F) {
    return GGEMS_NAVIGATION_RESOLVED;
  }

  float c = dot(offset, offset) - radius * radius;
  float discriminant = b * b - a * c;

  if (GGEMS_NavigationIsFinite(discriminant) == 0U) {
    return GGEMS_NAVIGATION_UNRESOLVED;
  }

  if (discriminant <= 0.0F) {
    return inside != 0U ? GGEMS_NAVIGATION_UNRESOLVED
                        : GGEMS_NAVIGATION_RESOLVED;
  }

  float root = sqrt(discriminant);
  float candidate = (inside != 0U ? -b + root : -b - root) / a;

  if (GGEMS_NavigationIsFinite(candidate) == 0U || candidate < 0.0F ||
      candidate >= *parameter) {
    return GGEMS_NAVIGATION_UNRESOLVED;
  }

  *parameter = candidate;

  witness->faces = 0U;
  witness->event = inside != 0U ? GGEMS_NAVIGATION_EVENT_VOLUME_EXIT
                                : GGEMS_NAVIGATION_EVENT_VOLUME_ENTRY;
  witness->arrival_volume_id =
    inside != 0U ? GGEMS_VOLUME_ID_WORLD : sphere->volume_id;
  witness->arrival_material_id =
    inside != 0U ? GGEMS_MATERIAL_ID_WORLD : sphere->material_id;

  return GGEMS_NAVIGATION_RESOLVED;
}

#endif
