/*!
 * \file
 * \brief Resolves full solid Sphere ownership and crossings in local FP32.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_SPHERE_NAVIGATION_CLH
/*! \brief Prevents repeated inclusion of the Sphere predicates. */
#define GGEMS_SPHERE_NAVIGATION_CLH

#include "geometry/GGEMSAnalyticVolumeRecord.clh"
#include "geometry/GGEMSBoxRecord.clh"
#include "navigation/GGEMSNavigation.clh"

/*!
 * \brief Locates the forward owner of a FP32 birth in the closed World.
 *
 * The host supplies a closed radial half-band. Strict interior points belong
 * to the Sphere. A band point belongs to it only when its forward ray reaches
 * the strict interior of the contracted sphere. Outward, tangent, and shallow
 * grazing band starts belong to the World. No position is displaced.
 * \param[in] sphere Complete ball and owner identities.
 * \param[in] position FP32 point already validated against the World.
 * \param[in] direction Actual finite, nonzero stored direction.
 * \param[out] owner Packed forward VolumeID/MaterialID.
 * \return Resolved according to the tolerant radial classification.
 */
static inline uint GGEMS_SphereLocate(__global GGEMSSphereRecord const *sphere,
                                      float3 position, float3 direction,
                                      ulong *owner) {
  float3 offset = position - (float3)(sphere->center_x_pm, sphere->center_y_pm,
                                      sphere->center_z_pm);

  float inner_radius = sphere->radius_pm - sphere->tolerance_pm;
  float outer_radius = sphere->radius_pm + sphere->tolerance_pm;
  float radius_squared = dot(offset, offset);
  float inner_squared = inner_radius * inner_radius;
  uint inside = radius_squared < inner_squared;

  if (inside == 0U && radius_squared <= outer_radius * outer_radius) {
    float motion = dot(offset, direction);
    if (motion < 0.0F) {
      float inverse_a = 1.0F / dot(direction, direction);
      float closest_parameter = -motion * inverse_a;
      float3 closest = offset + closest_parameter * direction;
      inside = dot(closest, closest) < inner_squared;
    }
  }

  *owner = inside != 0U
             ? ((ulong)sphere->volume_id << 32U) | sphere->material_id
             : ((ulong)GGEMS_VOLUME_ID_WORLD << 32U) | GGEMS_MATERIAL_ID_WORLD;
  return GGEMS_NAVIGATION_RESOLVED;
}

/*!
 * \brief Selects a tolerant FP32 Sphere crossing against the World exit.
 *
 * Projecting to closest approach avoids subtracting two World-scale squared
 * quantities in the quadratic discriminant. An outside ray must penetrate
 * strictly beyond the radial half-band; tangent and shallow contacts retain
 * the World witness. Accepted parameters still intersect the nominal radius.
 * The accepted owner selects the exit root, so rounding the entry anchor does
 * not require a push. Analytic dispatch suppresses convex reentry after exit.
 * \param[in] sphere Immutable full ball.
 * \param[in] position FP32 start in the closed World.
 * \param[in] direction Actual stored finite direction.
 * \param[in] current_owner Accepted departure owner.
 * \param[in,out] witness World exit on entry; chosen crossing on success.
 * \return Resolved or unresolved for invalid arithmetic or boundary ordering.
 */
static inline uint
GGEMS_SphereFindBoundary(__global GGEMSSphereRecord const *sphere,
                         float3 position, float3 direction, uint current_owner,
                         GGEMSBoundaryWitness *witness) {
  float3 offset = position - (float3)(sphere->center_x_pm, sphere->center_y_pm,
                                      sphere->center_z_pm);

  float radius = sphere->radius_pm;
  float a = dot(direction, direction);
  float b = dot(offset, direction);

  uint inside = current_owner == sphere->volume_id;

  if (inside == 0U && b >= 0.0F) {
    return GGEMS_NAVIGATION_RESOLVED;
  }

  float inverse_a = 1.0F / a;
  float closest_parameter = -b * inverse_a;
  float3 closest = offset + closest_parameter * direction;
  float closest_squared = dot(closest, closest);
  float inner_radius = radius - sphere->tolerance_pm;

  if (inside == 0U && closest_squared >= inner_radius * inner_radius) {
    return GGEMS_NAVIGATION_RESOLVED;
  }

  float half_chord =
    sqrt(fmax(0.0F, radius * radius - closest_squared) * inverse_a);

  float candidate = fmax(0.0F, inside != 0U ? closest_parameter + half_chord
                                            : closest_parameter - half_chord);

  if (GGEMS_NavigationIsFinite(candidate) == 0U ||
      candidate >= witness->parameter) {
    return GGEMS_NAVIGATION_UNRESOLVED;
  }

  witness->parameter = candidate;

  witness->faces = 0U;
  witness->event = inside != 0U ? GGEMS_NAVIGATION_EVENT_VOLUME_EXIT
                                : GGEMS_NAVIGATION_EVENT_VOLUME_ENTRY;
  witness->arrival_volume_id =
    inside != 0U ? GGEMS_VOLUME_ID_WORLD : sphere->volume_id;
  witness->arrival_material_id =
    inside != 0U ? GGEMS_MATERIAL_ID_WORLD : sphere->material_id;

  return GGEMS_NAVIGATION_RESOLVED;
}

#endif
