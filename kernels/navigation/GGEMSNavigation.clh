/*!
 * \file
 * \brief Shared Navigation events and exact World boundary evidence.
 *
 * Analytic Box and Sphere predicates use transient FP32 parameters. World
 * navigation keeps its exact integer witness; Transport owns every movement.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_NAVIGATION_CLH
/*! \brief Prevents repeated inclusion of Navigation declarations. */
#define GGEMS_NAVIGATION_CLH

#include "geometry/GGEMSBoxRecord.clh"
#include "geometry/GGEMSWorldRecord.clh"
#include "navigation/GGEMSWorldNavigation.clh"

/*! \brief Query resolved: the witness describes the first physical boundary. */
#define GGEMS_NAVIGATION_RESOLVED 0U

/*! \brief The start lies outside the closed World. */
#define GGEMS_NAVIGATION_OUTSIDE_WORLD 1U

/*! \brief The ray, record, or analytic arithmetic cannot be resolved. */
#define GGEMS_NAVIGATION_UNRESOLVED 2U

/*! \brief No accepted boundary event. */
#define GGEMS_NAVIGATION_EVENT_NONE 0U

/*!
 * \brief The ray leaves the World through the crossed planes; the arrival
 * owner is GGEMS_VOLUME_ID_EXTERIOR.
 */
#define GGEMS_NAVIGATION_EVENT_WORLD_EXIT 1U

/*! \brief The ray enters the open interior of a physical volume. */
#define GGEMS_NAVIGATION_EVENT_VOLUME_ENTRY 2U

/*! \brief The ray leaves the closed support of its current physical volume. */
#define GGEMS_NAVIGATION_EVENT_VOLUME_EXIT 3U

/*!
 * \brief Dense Material identity of the World medium: the host interns the
 * World medium first, so the Materials authority assigns it identity 0.
 */
#define GGEMS_MATERIAL_ID_WORLD 0U

/*! \brief Material identity of the exterior: no medium. */
#define GGEMS_MATERIAL_ID_NONE 0xFFFFFFFFU

/*!
 * \brief Selected physical event and its arrival owner.
 *
 * gap_pm, mantissa and exponent describe exact World movement only. Analytic
 * movement uses the separate FP32 parameter. faces is a World or local Box
 * crossing mask, and zero for Sphere.
 */
typedef struct GGEMSBoundaryWitness {
  /*! \brief Forward integer gap to the limiting plane along its axis. */
  ulong gap_pm;

  /*! \brief Significand of the limiting direction component. */
  uint mantissa;

  /*! \brief Binary exponent of the limiting direction component. */
  int exponent;

  /*! \brief Exact simultaneous crossing planes of the limiting volume. */
  uint faces;

  /*! \brief GGEMS_NAVIGATION_EVENT_* describing the boundary. */
  uint event;

  /*! \brief Physical owner after the boundary; exterior after a World exit. */
  uint arrival_volume_id;

  /*! \brief Dense Material identity of the arrival owner. */
  uint arrival_material_id;

  /*! \brief GGEMS_NAVIGATION_RESOLVED, OUTSIDE_WORLD or UNRESOLVED. */
  uint status;
} GGEMSBoundaryWitness;

/*!
 * \brief Checks the FP32 exponent without finite-math compiler assumptions.
 * \param[in] value Arithmetic result to inspect.
 * \return Nonzero for a finite FP32 value, including signed zero.
 */
static inline uint GGEMS_NavigationIsFinite(float value) {
  return (as_uint(value) & 0x7F800000U) != 0x7F800000U;
}

/*!
 * \brief Initializes the selected event with the exact World exit.
 *
 * Private pointer output preserves the established Intel compiler workaround:
 * nested structure-returning navigation queries corrupted Transport state on
 * Intel Graphics NEO 26.35 with -cl-opt-disable.
 * \param[in] world Immutable finite World.
 * \param[in] position Canonical global anchor in integer pm.
 * \param[in] direction Actual stored direction.
 * \param[out] witness Exact World evidence and exterior arrival owner.
 * \return Resolved, outside World, or unresolved.
 */
static inline uint
GGEMS_NavigationFindWorldBoundary(__global GGEMSWorldRecord const *world,
                                  long3 position, float3 direction,
                                  GGEMSBoundaryWitness *witness) {
  GGEMSWorldBoundary world_exit =
    GGEMS_WorldFindBoundary(world, position, direction);

  witness->gap_pm = world_exit.gap_pm;
  witness->mantissa = world_exit.direction.mantissa;
  witness->exponent = world_exit.direction.exponent;
  witness->faces = world_exit.faces;
  witness->event = world_exit.status == GGEMS_WORLD_EXIT
                     ? GGEMS_NAVIGATION_EVENT_WORLD_EXIT
                     : GGEMS_NAVIGATION_EVENT_NONE;
  witness->arrival_volume_id = GGEMS_VOLUME_ID_EXTERIOR;
  witness->arrival_material_id = GGEMS_MATERIAL_ID_NONE;
  witness->status = world_exit.status;

  return world_exit.status;
}

#endif
