/*!
 * \file
 * \brief Defines Navigation events and transient FP32 boundary evidence.
 *
 * World and all analytic predicates return FP32 ray parameters in picometers.
 * The actual stored direction determines the ray; predicates do not assume
 * exact unit length. Transport owns accepted movement and owner updates.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_NAVIGATION_CLH
/*! \brief Prevents repeated inclusion of Navigation declarations. */
#define GGEMS_NAVIGATION_CLH

/*! \brief Query resolved: the witness describes the first physical boundary. */
#define GGEMS_NAVIGATION_RESOLVED 0U

/*! \brief The start lies beyond the World's closed surface half-band. */
#define GGEMS_NAVIGATION_OUTSIDE_WORLD 1U

/*! \brief The ray, record, or analytic arithmetic cannot be resolved. */
#define GGEMS_NAVIGATION_UNRESOLVED 2U

/*! \brief No accepted boundary event. */
#define GGEMS_NAVIGATION_EVENT_NONE 0U

/*!
 * \brief The ray leaves the World through the crossed planes; the arrival
 * owner is GGEMS_VOLUME_ID_EXTERIOR.
 */
#define GGEMS_NAVIGATION_EVENT_WORLD_EXIT 1U

/*! \brief The ray enters the open interior of a physical volume. */
#define GGEMS_NAVIGATION_EVENT_VOLUME_ENTRY 2U

/*! \brief The ray leaves the closed support of its current physical volume. */
#define GGEMS_NAVIGATION_EVENT_VOLUME_EXIT 3U

/*! \brief One internal cell crossing within the same physical voxel volume. */
#define GGEMS_NAVIGATION_EVENT_VOXEL_BOUNDARY 4U

/*! \brief No active private voxel cursor. */
#define GGEMS_VOXEL_CURSOR_INVALID 0xFFFFFFFFU

/*!
 * \brief Private continuation for one straight-flight voxelized visit.
 *
 * This is not part of the particle ABI. Fresh location initializes the local
 * ray and cell once; internal crossings advance both without another frame
 * transform. Callers invalidate record_index before reconciling any direction
 * change.
 */
typedef struct GGEMSVoxelCursor {
  /*! \brief Dense voxel record index, or GGEMS_VOXEL_CURSOR_INVALID. */
  uint record_index;

  /*! \brief Current X/Y/Z cell coordinates. */
  uint cell[3];

  /*! \brief Local direction reciprocals; zero denotes a parallel axis. */
  float inverse_direction[3];

  /*! \brief Local anchor advanced by the accepted physical parameter. */
  float local_position[3];

  /*! \brief Stored direction transformed into this grid's local frame. */
  float local_direction[3];

  /*! \brief FP32 global-addition residual; zero at a fresh grid visit. */
  float global_residual[3];

  /*! \brief Current X-fastest index in the shared compact label field. */
  ulong label_index;
} GGEMSVoxelCursor;

/*!
 * \brief Dense Material identity of the World medium: the host interns the
 * World medium first, so the Materials authority assigns it identity 0.
 */
#define GGEMS_MATERIAL_ID_WORLD 0U

/*! \brief Material identity of the exterior: no medium. */
#define GGEMS_MATERIAL_ID_NONE 0xFFFFFFFFU

/*!
 * \brief Selected physical event and its arrival owner.
 *
 * The FP32 parameter applies to World, analytical, and voxelized movement.
 * Faces is a World or local planar crossing mask, and zero for curved solids.
 */
typedef struct GGEMSBoundaryWitness {
  /*! \brief Forward FP32 ray parameter in pm. */
  float parameter;

  /*! \brief Simultaneous FP32 crossing planes of the limiting volume. */
  uint faces;

  /*! \brief GGEMS_NAVIGATION_EVENT_* describing the boundary. */
  uint event;

  /*! \brief Physical owner after the boundary; exterior after a World exit. */
  uint arrival_volume_id;

  /*! \brief Dense Material identity of the arrival owner. */
  uint arrival_material_id;

  /*! \brief GGEMS_NAVIGATION_RESOLVED, OUTSIDE_WORLD or UNRESOLVED. */
  uint status;
} GGEMSBoundaryWitness;

/*!
 * \brief Checks the FP32 exponent without finite-math compiler assumptions.
 *
 * The volatile integer round trip is a compiler barrier: Intel CPU OpenCL
 * 2026.21 folds a plain exponent mask into an assumed-finite result under
 * -cl-fast-relaxed-math, accepting NaN/Inf inputs and overflowing endpoints.
 * A noinline float helper does not prevent that transformation. Current
 * production kernels use standard optimized math without that relaxed option;
 * the integer check retains explicit nonfinite detection.
 * \param[in] value Arithmetic result to inspect.
 * \return Nonzero for a finite FP32 value, including signed zero.
 */
static inline uint GGEMS_NavigationIsFinite(float value) {
  volatile uint bits = as_uint(value);
  return (bits & 0x7F800000U) != 0x7F800000U;
}

/*!
 * \brief Forms a compensated increment of the same physical ray parameter.
 *
 * The residual accounts for preceding FP32 additions. It is arithmetic working
 * state, not a geometric displacement or an adjustment to the selected
 * distance.
 * \param[in] parameter Accepted physical ray parameter in pm.
 * \param[in] direction Stored global direction.
 * \param[in] residual Rounding residual of the preceding global addition.
 * \return Increment shared by voxel-exit prediction and Transport commit.
 */
static inline float3 GGEMS_NavigationCompensatedIncrement(float parameter,
                                                          float3 direction,
                                                          float3 residual) {
  return fma((float3)(parameter), direction, -residual);
}

#endif
