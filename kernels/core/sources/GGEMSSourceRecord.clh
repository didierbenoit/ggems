#ifndef GGEMS_CORE_SOURCES_GGEMS_SOURCE_RECORD_CLH
#define GGEMS_CORE_SOURCES_GGEMS_SOURCE_RECORD_CLH

#define GGEMS_SOURCE_TYPE_UNKNOWN 0U
#define GGEMS_SOURCE_TYPE_ANALYTIC 1U
#define GGEMS_SOURCE_TYPE_VOXELIZED 2U
#define GGEMS_SOURCE_TYPE_PHASE_SPACE 3U

typedef struct GGEMSSourceRecord {
  ulong source_id;

  ulong time_start_ps;
  ulong time_stop_ps;

  ulong energy_milli_eV;

  long position_x_pm;
  long position_y_pm;
  long position_z_pm;

  uint source_type;
  uint emitted_particle_type;
  uint flags;
  uint reserved_0;

  float axis_x_x;
  float axis_x_y;
  float axis_x_z;

  float axis_y_x;
  float axis_y_y;
  float axis_y_z;

  float axis_z_x;
  float axis_z_y;
  float axis_z_z;

  float weight;
} GGEMSSourceRecord;

#endif
