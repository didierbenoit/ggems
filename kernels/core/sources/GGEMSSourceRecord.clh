#ifndef GGEMS_CORE_SOURCES_GGEMS_SOURCE_RECORD_CLH
#define GGEMS_CORE_SOURCES_GGEMS_SOURCE_RECORD_CLH

#define GGEMS_SOURCE_TYPE_UNKNOWN 0U
#define GGEMS_SOURCE_TYPE_ANALYTIC 1U
#define GGEMS_SOURCE_TYPE_VOXELIZED 2U
#define GGEMS_SOURCE_TYPE_PHASE_SPACE 3U

#define GGEMS_EMISSION_GEOMETRY_TYPE_UNKNOWN 0U
#define GGEMS_EMISSION_GEOMETRY_TYPE_POINT 1U
#define GGEMS_EMISSION_GEOMETRY_TYPE_RECTANGLE 2U
#define GGEMS_EMISSION_GEOMETRY_TYPE_ELLIPSE 3U

#define GGEMS_ANGULAR_DISTRIBUTION_TYPE_UNKNOWN 0U
#define GGEMS_ANGULAR_DISTRIBUTION_TYPE_FIXED 1U
#define GGEMS_ANGULAR_DISTRIBUTION_TYPE_ISOTROPIC 2U
#define GGEMS_ANGULAR_DISTRIBUTION_TYPE_FOCUSED 3U

typedef struct GGEMSSourceRecord {
  ulong source_id;

  ulong time_start_ps;
  ulong time_stop_ps;

  ulong energy_milli_eV;

  long position_x_pm;
  long position_y_pm;
  long position_z_pm;

  uint source_type;
  uint emitted_particle_type;
  uint flags;
  uint reserved_0;

  float axis_x_x;
  float axis_x_y;
  float axis_x_z;

  float axis_y_x;
  float axis_y_y;
  float axis_y_z;

  float axis_z_x;
  float axis_z_y;
  float axis_z_z;

  float weight;

  uint emission_geometry_type;
  uint angular_distribution_type;

  ulong geometry_size_x_pm;
  ulong geometry_size_y_pm;

  long focus_position_x_pm;
  long focus_position_y_pm;
  long focus_position_z_pm;
} GGEMSSourceRecord;

#endif
