#ifndef GGEMS_CORE_SOURCES_GGEMS_ENERGY_DISTRIBUTION_CLH
#define GGEMS_CORE_SOURCES_GGEMS_ENERGY_DISTRIBUTION_CLH

#include "core/random/GGEMSRandom.clh"
#include "core/sources/GGEMSEnergyDistributionRecord.clh"
#include "core/sources/GGEMSSourceRecord.clh"

// =============================================================================
// =============================================================================

static inline uint GGEMS_EnergyDistributionFindIndex(
    __global GGEMSEnergyDistributionRecord const *distribution,
    __global ulong const *cumulative_ticket_upper, uint raw_ticket) {
  ulong const ticket = (ulong)(raw_ticket);
  uint lower = 0U;
  uint upper = distribution->table_count;

  for (uint iteration = 0U; iteration < 32U && lower < upper; ++iteration) {
    uint const middle = lower + (upper - lower) / 2U;
    ulong const ticket_upper =
        cumulative_ticket_upper[distribution->table_offset + (ulong)(middle)];

    if (ticket < ticket_upper) {
      upper = middle;
    } else {
      lower = middle + 1U;
    }
  }

  return lower;
}

// =============================================================================
// =============================================================================

static inline ulong
GGEMS_EnergyDistributionMapRegularOffset(ulong width, ulong ticket_span,
                                         ulong local_ticket) {
  ulong const quotient = width / ticket_span;
  ulong const remainder = width % ticket_span;

  return quotient * local_ticket + (remainder * local_ticket) / ticket_span;
}

// =============================================================================
// =============================================================================

static inline ulong GGEMS_EnergyDistributionSampleWithTicket(
    __global GGEMSEnergyDistributionRecord const *distribution,
    __global ulong const *energy_values_milli_eV,
    __global ulong const *cumulative_ticket_upper, uint raw_ticket) {
  uint const selected_index = GGEMS_EnergyDistributionFindIndex(
      distribution, cumulative_ticket_upper, raw_ticket);
  ulong const packed_index =
      distribution->table_offset + (ulong)(selected_index);
  ulong const selected_energy = energy_values_milli_eV[packed_index];

  if (distribution->distribution_type ==
      GGEMS_ENERGY_DISTRIBUTION_TYPE_DISCRETE_LINES) {
    return selected_energy;
  }

  ulong const ticket_lower =
      selected_index == 0U ? 0UL : cumulative_ticket_upper[packed_index - 1UL];
  ulong const ticket_upper = cumulative_ticket_upper[packed_index];
  ulong const ticket_span = ticket_upper - ticket_lower;
  ulong const local_ticket = (ulong)(raw_ticket)-ticket_lower;

  ulong const bin_width = distribution->regular_bin_width_milli_eV;
  ulong const lower_edge = selected_energy - bin_width / 2UL;
  ulong const in_bin_offset = GGEMS_EnergyDistributionMapRegularOffset(
      bin_width, ticket_span, local_ticket);

  return lower_edge + in_bin_offset;
}

// =============================================================================
// =============================================================================

static inline ulong GGEMS_EnergyDistributionSample(
    __global GGEMSSourceRecord const *source,
    __global GGEMSEnergyDistributionRecord const *distribution,
    __global ulong const *energy_values_milli_eV,
    __global ulong const *cumulative_ticket_upper,
    __global GGEMSRandomState *random_states, uint worker_id) {
  if (distribution->distribution_type == GGEMS_ENERGY_DISTRIBUTION_TYPE_MONO) {
    return source->energy_milli_eV;
  }

  uint const raw_ticket = GGEMS_RndmUInt32(random_states, worker_id);
  return GGEMS_EnergyDistributionSampleWithTicket(
      distribution, energy_values_milli_eV, cumulative_ticket_upper,
      raw_ticket);
}

#endif
