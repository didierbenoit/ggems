/*!
 * \file
 * \brief Declares the OpenCL PCG32 random-number engine.
 *
 * Provides raw 32-bit output and scalar uniform sampling from per-stream PCG32 state.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_CORE_RANDOM_GGEMS_PCG32_CLH
#define GGEMS_CORE_RANDOM_GGEMS_PCG32_CLH

#include "core/random/GGEMSRandomCommon.clh"
#include "core/random/GGEMSRandomTypes.clh"

/*!
 * \brief Advances a PCG32 stream and returns the next raw 32-bit value.
 * \param[in,out] states Array of PCG32 stream states.
 * \param[in] index State index identifying the logical stream.
 * \return Next raw PCG32 word.
 */
static inline uint GGEMS_PCG32NextUInt(__global GGEMSPCG32State *states,
                                       uint index) {
  ulong old_state = states[index].state;

  states[index].state =
      old_state * 6364136223846793005UL + states[index].increment;

  uint xorshifted = (uint)(((old_state >> 18U) ^ old_state) >> 27U);

  uint rotation = (uint)(old_state >> 59U);

  return (xorshifted >> rotation) | (xorshifted << ((0U - rotation) & 31U));
}

/*!
 * \brief Generates a scalar uniform value from a PCG32 stream.
 * \param[in,out] states Array of PCG32 stream states.
 * \param[in] index State index identifying the logical stream.
 * \return Uniform binary32 value in [0, 1).
 */
static inline float GGEMS_PCG32Uniform(__global GGEMSPCG32State *states,
                                       uint index) {
  uint value = GGEMS_PCG32NextUInt(states, index);

  return GGEMS_UIntToUniform01(value);
}

#endif
