#ifndef GGEMS_CORE_RANDOM_GGEMS_RANDOM_TYPES_CLH
#define GGEMS_CORE_RANDOM_GGEMS_RANDOM_TYPES_CLH

typedef struct GGEMSJKissState {
  uint x;
  uint y;
  uint z;
  uint w;
  uint c;
} GGEMSJKissState;

typedef struct GGEMSPCG32State {
  ulong state;
  ulong increment;
} GGEMSPCG32State;

typedef struct GGEMSPhiloxState {
  uint counter_0;
  uint counter_1;
  uint counter_2;
  uint counter_3;
  uint key_0;
  uint key_1;
} GGEMSPhiloxState;

#endif
