/*!
 * \file
 * \brief Declares the OpenCL JKISS random-number engine.
 *
 * Provides raw 32-bit output and scalar uniform sampling from per-stream JKISS state.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_CORE_RANDOM_GGEMS_JKISS_CLH
#define GGEMS_CORE_RANDOM_GGEMS_JKISS_CLH

#include "core/random/GGEMSRandomCommon.clh"
#include "core/random/GGEMSRandomTypes.clh"

// =============================================================================
// =============================================================================

/*!
 * \brief Advances a JKISS stream and returns the next raw 32-bit value.
 * \param[in,out] states Array of JKISS stream states.
 * \param[in] index State index identifying the logical stream.
 * \return Next raw JKISS word.
 */
static inline uint GGEMS_JKissNextUInt(__global GGEMSJKissState *states,
                                       uint index) {
  uint y = states[index].y;

  y ^= y << 5;
  y ^= y >> 7;
  y ^= y << 22;

  states[index].y = y;

  uint t = states[index].z + states[index].w + states[index].c;

  states[index].z = states[index].w;
  states[index].c = t >> 31;
  states[index].w = t & 2147483647U;
  states[index].x += 1411392427U;

  return states[index].x + states[index].y + states[index].w;
}

// =============================================================================
// =============================================================================

/*!
 * \brief Generates a scalar uniform value from a JKISS stream.
 * \param[in,out] states Array of JKISS stream states.
 * \param[in] index State index identifying the logical stream.
 * \return Uniform binary32 value in [0, 1).
 */
static inline float GGEMS_JKissUniform(__global GGEMSJKissState *states,
                                       uint index) {
  uint value = GGEMS_JKissNextUInt(states, index);

  return GGEMS_UIntToUniform01(value);
}

#endif
