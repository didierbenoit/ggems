/*!
 * \file
 * \brief Defines one immutable radioactive emission descriptor.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_SOURCES_GGEMS_SOURCE_EMISSION_RECORD_CLH
#define GGEMS_SOURCES_GGEMS_SOURCE_EMISSION_RECORD_CLH

/*!
 * \brief Connects an emission population to its species and energy law.
 *
 * Field order and widths match the host record. Emission groups are populated
 * separately on the host; these records do not form a categorical choice
 * between all emissions of one decay.
 */
typedef struct GGEMSSourceEmissionRecord {
  /*! \brief Particle-species code for this emission population. */
  uint particle_type;

  /*! \brief Index in the packed energy-distribution descriptor array. */
  uint energy_distribution_record_index;

  /*! \brief Exact mono energy in micro-eV; zero for a tabulated law. */
  ulong mono_energy_micro_eV;
} GGEMSSourceEmissionRecord;

#endif
