/*!
 * \file
 * \brief Defines the primary interval assigned to a source for one run.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_SOURCES_GGEMS_SOURCE_RUN_RANGE_CLH
#define GGEMS_SOURCES_GGEMS_SOURCE_RUN_RANGE_CLH

/*!
 * \brief Locates one source slot in the concatenated run population.
 *
 * The half-open interval is [projection_primary_begin, projection_primary_begin
 * + primary_count). Despite the historical projection name, the index is
 * run-wide. Device chunks intersect these ranges; they do not renumber them.
 * Field order and widths match the host record.
 */
typedef struct GGEMSSourceRunRange {
  /*! \brief Inclusive first primary index in the run-wide population. */
  ulong projection_primary_begin;

  /*! \brief Number of primaries assigned to this source; zero is allowed. */
  ulong primary_count;
} GGEMSSourceRunRange;

#endif
