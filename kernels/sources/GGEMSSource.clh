/*!
 * \file
 * \brief Samples primary birth states from host-prepared source records.
 *
 * Global and local positions use binary32 picometers, times use unsigned
 * integer picoseconds, and energies use unsigned integer microelectronvolts.
 * Geometry and direction calculations use binary32. The host validates source
 * tags, geometry, frames, focus, table ranges, and array capacities; these
 * helpers do not repeat that validation.
 *
 * Random-state indices select worker-owned buffer elements. A source-local
 * primary index selects an emission range; it does not seed the RNG. These
 * helpers initialize primaries and do not perform navigation, physical
 * interactions, or secondary production.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_SOURCES_GGEMS_SOURCE_CLH

/*! \brief Prevents repeated inclusion of this OpenCL header. */
#define GGEMS_SOURCES_GGEMS_SOURCE_CLH

#include "particles/GGEMSParticleState.clh"
#include "random/GGEMSRandom.clh"
#include "radioactivity/GGEMSRadioactiveTimeSampling.clh"
#include "sources/GGEMSSourcePopulationRecord.clh"
#include "sources/GGEMSEnergyDistribution.clh"
#include "sources/GGEMSSourceRecord.clh"
#include "sources/GGEMSSourceEmissionRange.clh"
#include "sources/GGEMSSourceEmissionRecord.clh"
#include "sources/GGEMSEnergyDistributionRecord.clh"

/*! \brief Binary32 full azimuth angle, in radians. */
#define GGEMS_SOURCE_TWO_PI_F 6.28318530717958647692f

// =============================================================================
// =============================================================================

/*!
 * \brief Recognizes supported volume emission geometries.
 *
 * \param[in] geometry_type Emission-geometry tag from the source record.
 * \return One for box, sphere, or cylinder; zero for all other tags.
 */
static inline uint GGEMS_SourceIsVolumeGeometry(uint geometry_type) {
  return geometry_type == GGEMS_EMISSION_GEOMETRY_TYPE_BOX ||
         geometry_type == GGEMS_EMISSION_GEOMETRY_TYPE_SPHERE ||
         geometry_type == GGEMS_EMISSION_GEOMETRY_TYPE_CYLINDER;
}

// =============================================================================
// =============================================================================

/*!
 * \brief Samples a planar offset in the source frame.
 *
 * Uses x/y uniform components for a rectangle or ellipse; z/w are ignored.
 * Rectangle sizes are full widths and ellipse sizes are full diameters. The
 * area-uniform ellipse transform uses
 * \f[
 * (x,y) = (a\sqrt{u_x}\cos(2\pi u_y),\; b\sqrt{u_x}\sin(2\pi u_y)),
 * \f]
 * where a and b are half the stored diameters. No RNG state is accessed.
 *
 * \param[in] source Host-validated source record in global memory.
 * \param[in] random_values Supplied dimensionless uniform components in [0, 1).
 * \return Binary32 local x/y offset in picometers; zero for other geometry
 * tags.
 */
static inline float2
GGEMS_SourceSampleLocalPosition(__global GGEMSSourceRecord const *source,
                                float4 random_values) {
  if (source->emission_geometry_type ==
      GGEMS_EMISSION_GEOMETRY_TYPE_RECTANGLE) {
    return (float2)((random_values.x - 0.5f) * source->geometry_size_x_pm,
                    (random_values.y - 0.5f) * source->geometry_size_y_pm);
  }

  if (source->emission_geometry_type == GGEMS_EMISSION_GEOMETRY_TYPE_ELLIPSE) {
    float const radius = sqrt(random_values.x);
    float const phi = GGEMS_SOURCE_TWO_PI_F * random_values.y;
    float cos_phi = 0.0f;
    float const sin_phi = sincos(phi, &cos_phi);

    return (float2)(0.5f * convert_float(source->geometry_size_x_pm) * radius *
                      cos_phi,
                    0.5f * convert_float(source->geometry_size_y_pm) * radius *
                      sin_phi);
  }

  return (float2)(0.0f, 0.0f);
}

// =============================================================================
// =============================================================================

/*!
 * \brief Samples a volume offset in the source frame.
 *
 * Uses x/y/z uniform components; w is ignored. Box sizes are full widths. A
 * sphere uses radius \f$R u_x^{1/3}\f$, cosine \f$1-2u_y\f$, and azimuth
 * \f$2\pi u_z\f$, where R is half geometry_size_x_pm. A cylinder uses radius
 * \f$R\sqrt{u_x}\f$, azimuth \f$2\pi u_y\f$, and axial offset \f$H(u_z-1/2)\f$,
 * where H is geometry_size_z_pm. These radial laws sample volume uniformly
 * before floating-point rounding. No RNG state is accessed.
 *
 * \param[in] source Host-validated source record in global memory.
 * \param[in] random_values Supplied dimensionless uniform components in [0, 1).
 * \return Binary32 local x/y/z offset in picometers; zero for other geometry
 * tags.
 */
static inline float3
GGEMS_SourceSampleLocalVolumePosition(__global GGEMSSourceRecord const *source,
                                      float4 random_values) {
  if (source->emission_geometry_type == GGEMS_EMISSION_GEOMETRY_TYPE_BOX) {
    return (float3)((random_values.x - 0.5f) * source->geometry_size_x_pm,
                    (random_values.y - 0.5f) * source->geometry_size_y_pm,
                    (random_values.z - 0.5f) * source->geometry_size_z_pm);
  }

  if (source->emission_geometry_type == GGEMS_EMISSION_GEOMETRY_TYPE_SPHERE) {
    float const radius =
      0.5f * source->geometry_size_x_pm * cbrt(random_values.x);

    float const cos_theta = 1.0f - 2.0f * random_values.y;
    float const sin_theta = sqrt(fmax(0.0f, 1.0f - cos_theta * cos_theta));

    float const phi = GGEMS_SOURCE_TWO_PI_F * random_values.z;
    float cos_phi = 0.0f;
    float const sin_phi = sincos(phi, &cos_phi);

    return (float3)(radius * sin_theta * cos_phi, radius * sin_theta * sin_phi,
                    radius * cos_theta);
  }

  if (source->emission_geometry_type == GGEMS_EMISSION_GEOMETRY_TYPE_CYLINDER) {
    float const radius =
      0.5f * source->geometry_size_x_pm * sqrt(random_values.x);

    float const phi = GGEMS_SOURCE_TWO_PI_F * random_values.y;
    float cos_phi = 0.0f;
    float const sin_phi = sincos(phi, &cos_phi);

    return (float3)(radius * cos_phi, radius * sin_phi,
                    (random_values.z - 0.5f) * source->geometry_size_z_pm);
  }

  return (float3)(0.0f, 0.0f, 0.0f);
}

// =============================================================================
// =============================================================================

/*!
 * \brief Maps a sampled local offset to FP32 global coordinates.
 *
 * Planar and volume shapes share the stored local-to-global transform.
 * No integer rounding, saturation, or RNG access occurs here.
 *
 * \param[in] source Host-validated source record in global memory.
 * \param[in] random_values Supplied dimensionless uniform components in [0, 1).
 * \return Global position in binary32 picometers.
 */
static inline float3
GGEMS_SourceSamplePositionFromUniforms(__global GGEMSSourceRecord const *source,
                                       float4 random_values) {
  float3 const local_position =
    GGEMS_SourceIsVolumeGeometry(source->emission_geometry_type) != 0U
      ? GGEMS_SourceSampleLocalVolumePosition(source, random_values)
      : (float3)(GGEMS_SourceSampleLocalPosition(source, random_values), 0.0f);

  float3 const displacement = (float3)(source->axis_x_x * local_position.x +
                                         source->axis_y_x * local_position.y +
                                         source->axis_z_x * local_position.z,
                                       source->axis_x_y * local_position.x +
                                         source->axis_y_y * local_position.y +
                                         source->axis_z_y * local_position.z,
                                       source->axis_x_z * local_position.x +
                                         source->axis_y_z * local_position.y +
                                         source->axis_z_z * local_position.z);

  return (float3)(source->position_x_pm, source->position_y_pm,
                  source->position_z_pm) +
         displacement;
}

// =============================================================================
// =============================================================================

/*!
 * \brief Samples a binary32 global birth position.
 *
 * A point consumes no random numbers. Every other geometry consumes one
 * GGEMS_RndmUniform4 call, including components unused by the selected
 * geometry. See GGEMS_SourceSamplePositionFromUniforms for the shared
 * transform.
 *
 * \param[in] source Host-validated source record in global memory.
 * \param[in,out] random_states Global RNG-state array; the selected element is
 * exclusively owned.
 * \param[in] worker_id Valid RNG-state buffer index for this worker.
 * \return Global position in binary32 picometers.
 */
static inline float3
GGEMS_SourceSamplePosition(__global GGEMSSourceRecord const *source,
                           __global GGEMSRandomState *random_states,
                           uint worker_id) {
  if (source->emission_geometry_type == GGEMS_EMISSION_GEOMETRY_TYPE_POINT) {
    return (float3)(source->position_x_pm, source->position_y_pm,
                    source->position_z_pm);
  }

  float4 const random_values = GGEMS_RndmUniform4(random_states, worker_id);

  return GGEMS_SourceSamplePositionFromUniforms(source, random_values);
}

// =============================================================================
// =============================================================================

/*!
 * \brief Checks the stored bounds for the full-sphere special case.
 *
 * Uses exact floating-point equality and does not check the
 * angular-distribution tag.
 *
 * \param[in] source Host-validated source record in global memory.
 * \return One when the cosine bounds are -1 and +1 and the azimuth bounds are 0
 * and GGEMS_SOURCE_TWO_PI_F; zero otherwise.
 */
static inline uint
GGEMS_SourceUsesDefaultFullSphere(__global GGEMSSourceRecord const *source) {
  return source->isotropic_cos_theta_lower == -1.0f &&
         source->isotropic_cos_theta_upper == 1.0f &&
         source->isotropic_phi_min_rad == 0.0f &&
         source->isotropic_phi_max_rad == GGEMS_SOURCE_TWO_PI_F;
}

// =============================================================================
// =============================================================================

/*!
 * \brief Constructs a dimensionless global birth direction.
 *
 * Fixed emission returns axis_z verbatim, without normalization. Isotropic
 * emission uses x/y uniform components for cosine and azimuth; z/w are ignored.
 * The full-sphere special case samples in global axes. Restricted bounds sample
 * cosine and azimuth uniformly in the stored source frame, rotate with the
 * stored axes, and normalize.
 *
 * Every other tag follows the focused branch. It forms the binary32
 * focus-minus-position difference and evaluates
 * \f[
 * \mathbf{d} = \operatorname{normalize}(\boldsymbol{\Delta}/s),
 * \qquad s=\max_i |\Delta_i|.
 * \f]
 * The host validates focus support and finite frame data. FP32 spatial collapse
 * can still produce a zero difference for an extended source; the resulting
 * invalid direction is reported by the transport path without repair.
 * It does not access RNG state.
 *
 * \param[in] source Host-validated source record in global memory.
 * \param[in] sampled_position Sampled global position in binary32 picometers.
 * \param[in] random_values Supplied dimensionless uniform components in [0, 1).
 * \return Binary32 direction produced by the selected angular branch.
 */
static inline float3 GGEMS_SourceSampleDirectionFromUniforms(
  __global GGEMSSourceRecord const *source, float3 sampled_position,
  float4 random_values) {
  if (source->angular_distribution_type ==
      GGEMS_ANGULAR_DISTRIBUTION_TYPE_FIXED) {
    return (float3)(source->axis_z_x, source->axis_z_y, source->axis_z_z);
  }

  if (source->angular_distribution_type ==
      GGEMS_ANGULAR_DISTRIBUTION_TYPE_ISOTROPIC) {

    float const u_theta = random_values.x;
    float const u_phi = random_values.y;

    if (GGEMS_SourceUsesDefaultFullSphere(source) != 0U) {
      float const cos_theta = 1.0f - 2.0f * u_theta;
      float const sin_theta = sqrt(fmax(0.0f, 1.0f - cos_theta * cos_theta));

      float const phi = GGEMS_SOURCE_TWO_PI_F * u_phi;
      float cos_phi = 0.0f;
      float const sin_phi = sincos(phi, &cos_phi);

      return normalize(
        (float3)(sin_theta * cos_phi, sin_theta * sin_phi, cos_theta));
    }

    float const cos_theta = source->isotropic_cos_theta_lower +
                            u_theta * (source->isotropic_cos_theta_upper -
                                       source->isotropic_cos_theta_lower);
    float const sin_theta = sqrt(fmax(0.0f, 1.0f - cos_theta * cos_theta));

    float const phi =
      source->isotropic_phi_min_rad +
      u_phi * (source->isotropic_phi_max_rad - source->isotropic_phi_min_rad);
    float cos_phi = 0.0f;
    float const sin_phi = sincos(phi, &cos_phi);

    float3 const local_direction =
      (float3)(sin_theta * cos_phi, sin_theta * sin_phi, cos_theta);

    float3 const global_direction =
      (float3)(source->axis_x_x * local_direction.x +
                 source->axis_y_x * local_direction.y +
                 source->axis_z_x * local_direction.z,
               source->axis_x_y * local_direction.x +
                 source->axis_y_y * local_direction.y +
                 source->axis_z_y * local_direction.z,
               source->axis_x_z * local_direction.x +
                 source->axis_y_z * local_direction.y +
                 source->axis_z_z * local_direction.z);

    return normalize(global_direction);
  }

  float3 const delta =
    (float3)(source->focus_position_x_pm, source->focus_position_y_pm,
             source->focus_position_z_pm) -
    sampled_position;

  float const scale = fmax(fabs(delta.x), fmax(fabs(delta.y), fabs(delta.z)));

  return normalize(delta / scale);
}

// =============================================================================
// =============================================================================

/*!
 * \brief Samples a direction using the worker RNG only for isotropic emission.
 *
 * Isotropic emission consumes one GGEMS_RndmUniform4 call. Fixed and focused
 * emission consume no random numbers. See
 * GGEMS_SourceSampleDirectionFromUniforms for normalization and focus
 * preconditions.
 *
 * \param[in] source Host-validated source record in global memory.
 * \param[in] sampled_position Sampled global position in binary32 picometers.
 * \param[in,out] random_states Global RNG-state array; the selected element is
 * exclusively owned.
 * \param[in] worker_id Valid RNG-state buffer index for this worker.
 * \return Dimensionless binary32 global direction.
 */
static inline float3 GGEMS_SourceSampleDirection(
  __global GGEMSSourceRecord const *source, float3 sampled_position,
  __global GGEMSRandomState *random_states, uint worker_id) {
  if (source->angular_distribution_type ==
      GGEMS_ANGULAR_DISTRIBUTION_TYPE_ISOTROPIC) {
    float4 const random_values = GGEMS_RndmUniform4(random_states, worker_id);
    return GGEMS_SourceSampleDirectionFromUniforms(source, sampled_position,
                                                   random_values);
  }

  return GGEMS_SourceSampleDirectionFromUniforms(source, sampled_position,
                                                 (float4)(0.0f));
}

// =============================================================================
// =============================================================================

/*!
 * \brief Initializes a count-driven primary birth state.
 *
 * The initialized state is alive with generation and local track_id zero,
 * an invalid local parent ID, and invalid navigation/material/region IDs. Time
 * is the stored window start and particle type comes from the source. Draw
 * order is position, direction, then energy; point, fixed/focused, and
 * monoenergetic branches skip their respective draws.
 *
 * \param[in] global_primary_id Global identity assigned to the new primary.
 * \param[in] source Host-validated source record in global memory.
 * \param[in] energy_distribution Host-prepared global energy descriptor with
 * valid table ranges.
 * \param[in] energy_values_micro_eV Global integer-microelectronvolt energy
 * table addressed by the descriptor.
 * \param[in] cumulative_ticket_upper Global exclusive cumulative ticket bounds
 * ending at 2^32 per distribution.
 * \param[in,out] random_states Global RNG-state array; the selected element is
 * exclusively owned.
 * \param[in] worker_id Valid RNG-state buffer index for this worker.
 * \param[out] particle Private destination initialized directly without a
 * struct return.
 */
static inline void GGEMS_SourceInitializePrimary(
  ulong global_primary_id, __global GGEMSSourceRecord const *source,
  __global GGEMSEnergyDistributionRecord const *energy_distribution,
  __global ulong const *energy_values_micro_eV,
  __global ulong const *cumulative_ticket_upper,
  __global GGEMSRandomState *random_states, uint worker_id,
  __private GGEMSParticleState *particle) {
  ulong const sampled_time_ps = source->time_start_ps;

  float3 const sampled_position =
    GGEMS_SourceSamplePosition(source, random_states, worker_id);

  float3 const sampled_direction = GGEMS_SourceSampleDirection(
    source, sampled_position, random_states, worker_id);

  ulong const sampled_energy_micro_eV = GGEMS_EnergyDistributionSample(
    source->energy_micro_eV, energy_distribution, energy_values_micro_eV,
    cumulative_ticket_upper, random_states, worker_id);

  particle->global_particle_id = global_primary_id;
  particle->track_id = 0U;
  particle->parent_track_id = GGEMS_INVALID_ID_U32;

  particle->time_ps = sampled_time_ps;

  particle->position_x_pm = sampled_position.x;
  particle->position_y_pm = sampled_position.y;
  particle->position_z_pm = sampled_position.z;

  particle->particle_type = (uchar)source->emitted_particle_type;
  particle->status = GGEMS_PARTICLE_STATUS_ALIVE;
  particle->generation = 0U;

  particle->current_navigator_id = GGEMS_INVALID_ID_U32;
  particle->current_volume_id = GGEMS_INVALID_ID_U32;
  particle->material_id = GGEMS_INVALID_ID_U32;
  particle->region_id = GGEMS_INVALID_ID_U32;

  particle->direction_x = sampled_direction.x;
  particle->direction_y = sampled_direction.y;
  particle->direction_z = sampled_direction.z;

  particle->energy_micro_eV = sampled_energy_micro_eV;
}

// =============================================================================
// =============================================================================

/*!
 * \brief Initializes a primary from an activity-driven emission.
 *
 * The initialized state is alive with generation and local track_id zero, an
 * invalid local parent ID, and invalid navigation/material/region IDs. Consumes
 * one raw word for the conditional radioactive birth time, then samples
 * position, direction, and energy in that order. The time word is consumed even
 * when an empty window makes the time helper return its start. Particle type
 * and monoenergetic fallback come from the emission. Emission populations have
 * already been realized on the host; this helper does not sample their counts.
 *
 * \param[in] global_primary_id Global identity assigned to the new primary.
 * \param[in] source_local_primary_id Source-local primary index; unused by this
 * initializer.
 * \param[in] source Host-validated source record in global memory.
 * \param[in] population Global population record with dimensionless scaled
 * decay and emission indices.
 * \param[in] emission Global emission record supplying particle type and
 * monoenergetic fallback.
 * \param[in] energy_distribution Host-prepared global energy descriptor with
 * valid table ranges.
 * \param[in] energy_values_micro_eV Global integer-microelectronvolt energy
 * table addressed by the descriptor.
 * \param[in] cumulative_ticket_upper Global exclusive cumulative ticket bounds
 * ending at 2^32 per distribution.
 * \param[in,out] random_states Global RNG-state array; the selected element is
 * exclusively owned.
 * \param[in] worker_id Valid RNG-state buffer index for this worker.
 * \param[out] particle Private destination initialized directly without a
 * struct return.
 */
static inline void GGEMS_SourceInitializeActivityDrivenPrimary(
  ulong global_primary_id, ulong source_local_primary_id,
  __global GGEMSSourceRecord const *source,
  __global GGEMSSourcePopulationRecord const *population,
  __global GGEMSSourceEmissionRecord const *emission,
  __global GGEMSEnergyDistributionRecord const *energy_distribution,
  __global ulong const *energy_values_micro_eV,
  __global ulong const *cumulative_ticket_upper,
  __global GGEMSRandomState *random_states, uint worker_id,
  __private GGEMSParticleState *particle) {
  (void)(source_local_primary_id);

  uint const time_raw_word = GGEMS_RndmUInt32(random_states, worker_id);
  ulong const sampled_time_ps = GGEMS_SampleRadioactiveTimeFromRaw(
    source->time_start_ps, source->time_stop_ps, population->scaled_decay,
    time_raw_word);

  float3 const sampled_position =
    GGEMS_SourceSamplePosition(source, random_states, worker_id);

  float3 const sampled_direction = GGEMS_SourceSampleDirection(
    source, sampled_position, random_states, worker_id);

  ulong const sampled_energy_micro_eV = GGEMS_EnergyDistributionSample(
    emission->mono_energy_micro_eV, energy_distribution, energy_values_micro_eV,
    cumulative_ticket_upper, random_states, worker_id);

  particle->global_particle_id = global_primary_id;
  particle->track_id = 0U;
  particle->parent_track_id = GGEMS_INVALID_ID_U32;
  particle->time_ps = sampled_time_ps;

  particle->position_x_pm = sampled_position.x;
  particle->position_y_pm = sampled_position.y;
  particle->position_z_pm = sampled_position.z;

  particle->particle_type = (uchar)emission->particle_type;
  particle->status = GGEMS_PARTICLE_STATUS_ALIVE;
  particle->generation = 0U;

  particle->current_navigator_id = GGEMS_INVALID_ID_U32;
  particle->current_volume_id = GGEMS_INVALID_ID_U32;
  particle->material_id = GGEMS_INVALID_ID_U32;
  particle->region_id = GGEMS_INVALID_ID_U32;

  particle->direction_x = sampled_direction.x;
  particle->direction_y = sampled_direction.y;
  particle->direction_z = sampled_direction.z;

  particle->energy_micro_eV = sampled_energy_micro_eV;
}

// =============================================================================
// =============================================================================

/*!
 * \brief Selects a source emission and initializes one primary.
 *
 * Count-driven mode directly uses energy_distribution_records[source_index].
 * Every other mode searches the population emission slice and selects the first
 * nonempty matching range. Its emission selects the energy descriptor. The
 * caller supplies consistent indices, counts, and array capacities; no bounds
 * checks are performed. A matching emission range is guaranteed by
 * the host-validated source configuration.
 *
 * \param[in] global_primary_id Global identity assigned to the new primary.
 * \param[in] source_local_primary_id Index within this source population, used
 * to select a half-open emission range.
 * \param[in] source_index Source array slot selecting the count-driven energy
 * descriptor, not source_id.
 * \param[in] source Host-validated source record in global memory.
 * \param[in] population Global population record with dimensionless scaled
 * decay and emission indices.
 * \param[in] source_emissions Global emission records addressed by population
 * indices.
 * \param[in] source_emission_ranges Global source-local ranges parallel to
 * source_emissions.
 * \param[in] energy_distribution_records Global descriptors: source-indexed
 * count-driven entries and emission-indexed entries.
 * \param[in] energy_values_micro_eV Global integer-microelectronvolt energy
 * table addressed by the descriptor.
 * \param[in] cumulative_ticket_upper Global exclusive cumulative ticket bounds
 * ending at 2^32 per distribution.
 * \param[in,out] random_states Global RNG-state array; the selected element is
 * exclusively owned.
 * \param[in] worker_id Valid RNG-state buffer index for this worker.
 * \param[out] particle Writable private state initialized from the selected
 * source emission.
 */
static inline void GGEMS_SourceTryInitializePrimary(
  ulong global_primary_id, ulong source_local_primary_id, uint source_index,
  __global GGEMSSourceRecord const *source,
  __global GGEMSSourcePopulationRecord const *population,
  __global GGEMSSourceEmissionRecord const *source_emissions,
  __global GGEMSSourceEmissionRange const *source_emission_ranges,
  __global GGEMSEnergyDistributionRecord const *energy_distribution_records,
  __global ulong const *energy_values_micro_eV,
  __global ulong const *cumulative_ticket_upper,
  __global GGEMSRandomState *random_states, uint worker_id,
  __private GGEMSParticleState *particle) {
  if (population->population_mode ==
      GGEMS_SOURCE_POPULATION_MODE_COUNT_DRIVEN) {
    __global GGEMSEnergyDistributionRecord const *energy_distribution =
      &energy_distribution_records[source_index];

    GGEMS_SourceInitializePrimary(
      global_primary_id, source, energy_distribution, energy_values_micro_eV,
      cumulative_ticket_upper, random_states, worker_id, particle);

    return;
  }

  for (uint local_emission_index = 0U;
       local_emission_index < population->emission_count;
       ++local_emission_index) {
    uint const emission_index =
      population->first_emission_index + local_emission_index;

    ulong const begin =
      source_emission_ranges[emission_index].source_local_primary_begin;

    ulong const count = source_emission_ranges[emission_index].primary_count;

    if (source_local_primary_id >= begin &&
        source_local_primary_id - begin < count) {
      __global GGEMSSourceEmissionRecord const *emission =
        &source_emissions[emission_index];

      __global GGEMSEnergyDistributionRecord const *energy_distribution =
        &energy_distribution_records[emission
                                       ->energy_distribution_record_index];

      GGEMS_SourceInitializeActivityDrivenPrimary(
        global_primary_id, source_local_primary_id, source, population,
        emission, energy_distribution, energy_values_micro_eV,
        cumulative_ticket_upper, random_states, worker_id, particle);

      return;
    }
  }
}

// =============================================================================
// =============================================================================

/*!
 * \brief Reads a diagnostic birth state directly from a source record.
 *
 * Copies the stored position, start time, axis_z direction, energy, and emitted
 * particle type. Despite the helper name, it neither forces nor checks the
 * aionino particle tag. It does not dispatch geometry, angle, or energy laws,
 * consume RNG state, or normalize the direction. Generation and local track ID
 * are zero; the global identity remains independent of the local track ID.
 *
 * \param[in] global_primary_id Global identity assigned to the new primary.
 * \param[in] source_local_primary_id Source-local primary index; unused by this
 * initializer.
 * \param[in] source Host-validated source record in global memory.
 * \return Alive diagnostic state with local track ID zero and invalid
 * parent and navigation IDs.
 */
static inline GGEMSParticleState
GGEMS_SourceReadAionino(ulong global_primary_id, ulong source_local_primary_id,
                        __global GGEMSSourceRecord const *source) {
  (void)(source_local_primary_id);

  GGEMSParticleState particle;

  particle.global_particle_id = global_primary_id;
  particle.track_id = 0U;
  particle.parent_track_id = GGEMS_INVALID_ID_U32;
  particle.time_ps = source->time_start_ps;

  particle.position_x_pm = source->position_x_pm;
  particle.position_y_pm = source->position_y_pm;
  particle.position_z_pm = source->position_z_pm;

  particle.particle_type = (uchar)source->emitted_particle_type;
  particle.status = GGEMS_PARTICLE_STATUS_ALIVE;
  particle.generation = 0U;

  particle.current_navigator_id = GGEMS_INVALID_ID_U32;
  particle.current_volume_id = GGEMS_INVALID_ID_U32;
  particle.material_id = GGEMS_INVALID_ID_U32;
  particle.region_id = GGEMS_INVALID_ID_U32;

  particle.direction_x = source->axis_z_x;
  particle.direction_y = source->axis_z_y;
  particle.direction_z = source->axis_z_z;

  particle.energy_micro_eV = source->energy_micro_eV;

  return particle;
}

#endif
