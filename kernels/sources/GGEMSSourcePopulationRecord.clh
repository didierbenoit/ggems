/*!
 * \file
 * \brief Defines per-source population selection and radioactive time data.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_SOURCES_GGEMS_SOURCE_POPULATION_RECORD_CLH

/*! \brief Prevents repeated inclusion of this OpenCL header. */
#define GGEMS_SOURCES_GGEMS_SOURCE_POPULATION_RECORD_CLH

/*! \brief Host-specified count with births at the window start. */
#define GGEMS_SOURCE_POPULATION_MODE_COUNT_DRIVEN 0U

/*! \brief Host-sampled emission counts with radioactive birth times. */
#define GGEMS_SOURCE_POPULATION_MODE_ACTIVITY_DRIVEN 1U

/*!
 * \brief Selects count-driven or activity-driven source initialization.
 *
 * There is one record per source slot. Activity-driven records address matching
 * slices of the emission descriptors and per-run emission ranges. The host
 * samples group populations; the device selects the owning group by its primary
 * range.
 */
typedef struct GGEMSSourcePopulationRecord {
  /*! \brief Numeric mode selecting count-driven or activity-driven births. */
  uint population_mode;

  /*! \brief First entry in the packed emission descriptor and range arrays. */
  uint first_emission_index;

  /*! \brief Emission group count; zero for a count-driven source. */
  uint emission_count;

  /*! \brief Dimensionless ln(2) times window duration divided by half-life. */
  float scaled_decay;
} GGEMSSourcePopulationRecord;

#endif
