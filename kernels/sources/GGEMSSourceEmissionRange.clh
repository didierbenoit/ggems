/*!
 * \file
 * \brief Defines the per-run primary range of one emission group.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_SOURCES_GGEMS_SOURCE_EMISSION_RANGE_CLH
#define GGEMS_SOURCES_GGEMS_SOURCE_EMISSION_RANGE_CLH

/*!
 * \brief Locates one emission group in its owning source population.
 *
 * The half-open interval is [source_local_primary_begin,
 * source_local_primary_begin + primary_count). Indices are source-local, not
 * device- or run-local. This array is parallel to the immutable emission
 * descriptor array and is refreshed for each run.
 */
typedef struct GGEMSSourceEmissionRange {
  /*! \brief Inclusive first primary index in the owning source slot. */
  ulong source_local_primary_begin;

  /*! \brief Number of primaries assigned to this emission; zero is allowed. */
  ulong primary_count;
} GGEMSSourceEmissionRange;

#endif
