/*!
 * \file
 * \brief Defines the shared device particle record and numeric species codes.
 *
 * \author Julien BERT <julien.bert@univ-brest.fr>
 * \author Didier BENOIT <didier.benoit@inserm.fr>
 */

#ifndef GGEMS_PARTICLES_GGEMS_PARTICLE_STATE_CLH

/*! \brief Prevents repeated inclusion of this OpenCL header. */
#define GGEMS_PARTICLES_GGEMS_PARTICLE_STATE_CLH

/*! \brief All-ones sentinel for an absent 32-bit identifier. */
#define GGEMS_INVALID_ID_U32 0xFFFFFFFFU

/*! \brief All-ones sentinel for an absent 64-bit identifier. */
#define GGEMS_INVALID_ID_U64 0xFFFFFFFFFFFFFFFFUL

/*! \brief Unspecified particle species. */
#define GGEMS_PARTICLE_TYPE_UNKNOWN 0U

/*! \brief Diagnostic particle without physical interactions. */
#define GGEMS_PARTICLE_TYPE_AIONINO 1U

/*! \brief Photon species code. */
#define GGEMS_PARTICLE_TYPE_GAMMA 2U

/*! \brief Electron species code. */
#define GGEMS_PARTICLE_TYPE_ELECTRON 3U

/*! \brief Positron species code. */
#define GGEMS_PARTICLE_TYPE_POSITRON 4U

/*! \brief Proton species code. */
#define GGEMS_PARTICLE_TYPE_PROTON 5U

/*! \brief Neutron species code. */
#define GGEMS_PARTICLE_TYPE_NEUTRON 6U

/*! \brief Alpha-particle species code. */
#define GGEMS_PARTICLE_TYPE_ALPHA 7U

/*!
 * \brief Reports whether the catalog defines a species as having no physical
 * interactions.
 *
 * Mirrors the host IsProcessFree: such a species is transported by geometry
 * alone, boundary by boundary, until the World exit. Physical species return
 * zero whether or not their Processes are implemented.
 * \param[in] particle_type Kernel species code.
 * \return Nonzero for a Process-free species.
 */
static inline uint GGEMS_ParticleIsProcessFree(uint particle_type) {
  return particle_type == GGEMS_PARTICLE_TYPE_AIONINO ? 1U : 0U;
}

/*! \brief Inactive particle slot. */
#define GGEMS_PARTICLE_STATUS_INACTIVE 0U

/*! \brief Particle eligible for further transport. */
#define GGEMS_PARTICLE_STATUS_ALIVE 1U

/*! \brief Particle marked as terminated. */
#define GGEMS_PARTICLE_STATUS_KILLED 2U

/*! \brief Particle marked as having left the world. */
#define GGEMS_PARTICLE_STATUS_ESCAPED_WORLD 3U

/*! \brief Particle marked as absorbed. */
#define GGEMS_PARTICLE_STATUS_ABSORBED 4U

/*!
 * \brief Stores the 80-byte device counterpart of the host particle state.
 *
 * Global positions use binary32 pm. Time and energy retain unsigned integer
 * ps and micro-eV. Direction components are dimensionless binary32 values.
 * Track identifiers are history-local, with zero reserved for the primary.
 * Current synthetic descendants retain the primary global identifier.
 * Natural tail padding carries no state. This record performs no validation,
 * normalization, or field initialization.
 */
typedef struct GGEMSParticleState {
  /*!
   * \brief Primary-history identifier shared by the current synthetic
   * descendants.
   */
  ulong global_particle_id;

  /*! \brief Nonnegative simulation time in integer picoseconds. */
  ulong time_ps;

  /*! \brief Nonnegative kinetic energy in integer micro-eV. */
  ulong energy_micro_eV;

  /*! \brief History-local track identifier; source primaries use zero. */
  uint track_id;

  /*! \brief History-local parent track identifier, or the invalid 32-bit
   * sentinel. */
  uint parent_track_id;

  /*! \brief Current navigator identifier, initially invalid. */
  uint current_navigator_id;

  /*! \brief Current volume identifier, initially invalid. */
  uint current_volume_id;

  /*! \brief Current material identifier, initially invalid. */
  uint material_id;

  /*! \brief Current region identifier, initially invalid. */
  uint region_id;

  /*! \brief Global X coordinate in binary32 picometers. */
  float position_x_pm;

  /*! \brief Global Y coordinate in binary32 picometers. */
  float position_y_pm;

  /*! \brief Global Z coordinate in binary32 picometers. */
  float position_z_pm;

  /*! \brief Dimensionless X direction component. */
  float direction_x;

  /*! \brief Dimensionless Y direction component. */
  float direction_y;

  /*!
   * \brief Dimensionless Z direction component, defaulting to +1 on the host.
   */
  float direction_z;

  /*! \brief Kernel numeric particle-species code. */
  uchar particle_type;

  /*! \brief Kernel numeric particle-status code. */
  uchar status;

  /*! \brief Descendant generation; source primaries start at zero. */
  uchar generation;
} GGEMSParticleState;

#endif
